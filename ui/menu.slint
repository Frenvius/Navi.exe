import { Theme, Glyphs, Glyph } from "theme.slint";
import { Shell, MenuEntry, MenuButton } from "shell.slint";
import { CloudData, CloudFlyout } from "cloud.slint";

component MenuRow inherits Rectangle {
    in property <bool> nav-options;
    in property <MenuEntry> entry;
    in property <bool> hot;
    in property <bool> keyboard;
    // Context menus (CommandBarFlyout) set labels 1px closer to the icon than dropdowns.
    in property <length> label-x: 44px;
    // Menus with both toggles and icons (Visualizar) keep a check column before the icons.
    in property <length> icon-x: 16px;
    // MenuFlyout separators are 3px, CommandBarFlyout ones 9px; the line is centered.
    in property <length> separator-height: 9px;
    // From the label or shortcut to the window edge.
    in property <length> right-padding: 16px;
    in property <length> shortcut-width;
    // The address bar's overflow list has 40px rows (plates 35px) where menus have 32px.
    in property <length> row-height: 32px;
    callback hovered();
    callback activated();
    property <bool> toggle-column: root.icon-x > 16px;
    // Submenus that can take a bullet sit 1px further left (see MenuEntry).
    property <length> shift: root.entry.toggle-submenu ? -1px : 0px;
    // Command bar dropdowns (MenuFlyout) set labels at 44px, context menus at 43px.
    property <bool> dropdown: root.label-x == 44px;
    property <bool> overflow: root.label-x == 39px;
    property <bool> context-row: root.label-x == 43px;
    height: root.entry.separator ? root.separator-height : root.row-height;
    // 4px margin, 12px padding, icon, 12px, label, shortcut / chevron, 16px, 12px, 4px.
    preferred-width: root.entry.separator ? 0px
        : root.label-x + root.shift + label.preferred-width
            + (root.entry.shortcut != "" ? 24px + shortcut.preferred-width : 0px)
            + (root.entry.submenu ? 36px : 0px) + root.right-padding;

    label := Text {
        x: root.label-x + root.shift;
        // The tab menu's 33px rows set their text 1px lower.
        y: root.overflow || root.row-height >= 40px ? -2px : root.row-height == 33px ? 0px : -1px;
        height: parent.height;
        visible: !root.entry.separator;
        text: root.entry.label;
        font-family: Theme.font-text;
        font-size: 14px;
        vertical-alignment: center;
        color: root.entry.disabled ? Theme.text-disabled : Theme.text;
    }
    shortcut := Text {
        x: parent.width - 16px - max(self.width, root.shortcut-width) - (root.entry.submenu ? 22px : 0px);
        y: root.row-height == 33px ? 1px : 0px;
        height: parent.height;
        visible: !root.entry.separator && root.entry.shortcut != "";
        text: root.entry.shortcut;
        font-family: Theme.font-small;
        font-size: 12px;
        vertical-alignment: center;
        color: root.entry.disabled ? Theme.text-disabled : Theme.text-secondary;
    }

    if root.entry.separator: Rectangle {
        y: floor((root.separator-height - 1px) / 2px) * 1px;
        height: 1px;
        background: Theme.flyout-separator;
    }

    // The 28px hover plate sits 2px inside the 32px row.
    if !root.entry.separator: Rectangle {
        x: 4px;
        y: root.overflow ? 0px : 2px;
        width: parent.width - 8px;
        height: parent.height - (root.overflow ? 0px : root.row-height >= 40px ? 5px : 4px);
        border-radius: 4px;
        background: root.entry.disabled ? transparent : touch.pressed ? Theme.subtle-pressed : root.hot && !root.keyboard ? Theme.subtle-hover : transparent;
        if root.hot && root.keyboard: Rectangle {
            x: root.context-row ? 2px : -3px;
            y: root.context-row ? 0px : root.overflow ? -3px : -2px;
            width: parent.width + (root.context-row ? -4px : 6px);
            height: parent.height + (root.context-row ? 0px : root.overflow ? 6px : 4px);
            border-radius: root.overflow ? 8px : 5px;
            border-width: 2px;
            border-color: Theme.text;
            Rectangle {
                x: 2px; y: 2px;
                width: parent.width - 4px; height: parent.height - 4px;
                border-radius: root.overflow ? 6px : 3px;
                border-width: 1px;
                border-color: Theme.focus-inner;
            }
        }

        touch := TouchArea {
            changed has-hover => {
                if self.has-hover && !root.keyboard { root.hovered(); }
            }
            moved => { root.hovered(); }
            clicked => {
                if !root.entry.disabled && !root.entry.submenu { root.activated(); }
            }
        }

        Rectangle {
            x: (root.nav-options ? 13px : 10px) + root.shift;
            y: root.nav-options ? 7px : 6px;
            width: 16px;
            height: 16px;
            if root.entry.checked: Glyph {
                text: Glyphs.check;
                font-size: root.nav-options ? 14px : 12px;
                color: root.nav-options ? Theme.text : Theme.text-secondary;
            }
            if root.entry.bullet && !root.entry.checked: Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Theme.text-secondary;
            }
        }
        if root.toggle-column || (!root.entry.bullet && !root.entry.checked): Image {
            x: root.icon-x - 4px + root.shift;
            y: root.overflow ? 8px : 6px;
            width: 16px;
            height: 16px;
            source: root.entry.icon;
            opacity: root.entry.disabled ? 0.36 : 1;
        }
        if root.entry.glyph != "": Glyph {
            x: root.icon-x - 4px;
            y: root.row-height == 33px ? 1px : 0px;
            width: 16px;
            text: root.entry.glyph;
            font-size: 16px;
            color: root.entry.disabled ? Theme.text-disabled : Theme.text;
        }
        // A 5 x 10 chevron centred 16px from the menu's edge; a dropdown's plain submenu
        // ("Agrupar por") has a 4 x 8 one.
        if root.entry.submenu: Glyph {
            x: parent.width - 25px + (root.entry.toggle-submenu ? -1px : root.dropdown ? -1px : 0px);
            width: 16px;
            text: Glyphs.chevron-right-med;
            font-size: root.entry.toggle-submenu ? 14px : root.dropdown ? 12px : 16px;
            color: Theme.text-secondary;
        }
    }
}

component IconButton inherits Rectangle {
    in property <MenuButton> button;
    in property <bool> focused;
    callback activated();
    width: 64px;
    // Explorer's command bar: 58px with one-line labels, 71px when one wraps.
    min-height: 49px;
    border-radius: 4px;
    background: root.button.disabled ? transparent : touch.pressed ? Theme.subtle-pressed : touch.has-hover ? Theme.subtle-hover : transparent;
    if root.focused: Rectangle {
        x: 2px; y: 1px;
        width: 56px; height: parent.height - 2px;
        border-radius: 4px;
        border-width: 2px;
        border-color: Theme.text;
        Rectangle {
            x: 2px; y: 2px;
            width: parent.width - 4px; height: parent.height - 4px;
            border-radius: 2px;
            border-width: 1px;
            border-color: Theme.focus-inner;
        }
    }
    touch := TouchArea {
        clicked => {
            if !root.button.disabled { root.activated(); }
        }
    }
    VerticalLayout {
        padding-top: 9px;
        padding-bottom: 0px;
        padding-left: 2px;
        padding-right: 2px;
        spacing: 5px;
        alignment: start;
        HorizontalLayout {
            alignment: center;
            Image {
                width: 16px;
                height: 16px;
                source: root.button.icon;
                opacity: root.button.disabled ? 0.36 : 1;
            }
        }
        Text {
            text: root.button.label;
            font-family: Theme.font-small;
            font-size: 12px;
            horizontal-alignment: center;
            wrap: char-wrap;
            color: root.button.disabled ? Theme.text-disabled : Theme.text;
        }
    }
}

component Flyout inherits Rectangle {
    in property <bool> keyboard;
    in-out property <int> button-hot: -1;
    property <length> focus-overhang: root.label-x == 39px ? 3px : 0px;
    in property <[MenuEntry]> items;
    in property <[MenuButton]> buttons;
    in property <bool> buttons-bottom;
    in property <int> open-index: -1;
    // In a popup window DWM draws the acrylic, border, corners and shadow.
    in property <bool> plain;
    in property <length> min-menu-width: 200px;
    in property <length> label-x: 44px;
    in property <bool> nav-options;
    in property <length> icon-x: 16px;
    in property <length> separator-height: 9px;
    in property <length> inner-padding: 4px;
    in property <length> extra-top;
    in property <length> right-padding: 16px;
    in property <length> shortcut-width;
    // The tallest the menu gets (0: no limit); past it, its rows scroll.
    in property <length> height-limit;
    in property <length> row-height: 32px;
    in property <length> row-gap;
    in-out property <int> hot: -1;
    callback activated(int);
    callback button(int);
    callback hover-changed(int, length);

    // Keeps a row brought up by the keyboard in view (scrolling menus have no separators).
    public function reveal(i: int) {
        let pitch = root.row-height + root.row-gap;
        if i * pitch < -rows-view.content-y {
            rows-view.content-y = -i * pitch;
        } else if i * pitch + root.row-height > -rows-view.content-y + rows-view.height {
            rows-view.content-y = -(i * pitch + root.row-height - rows-view.height);
        }
    }

    changed items => { rows-view.content-y = 0; }

    property <length> natural: layout.preferred-width;
    width: max(root.min-menu-width, min(420px, root.natural));
    height: layout.preferred-height;
    border-radius: root.plain ? 0px : 8px;
    border-width: root.plain ? 0px : 1px;
    border-color: Theme.flyout-border;
    // Over DWM's acrylic, which is lighter than XAML's flyout acrylic.
    background: root.plain ? transparent : Theme.flyout;
    drop-shadow-blur: root.plain ? 0px : 16px;
    drop-shadow-offset-y: root.plain ? 0px : 8px;
    drop-shadow-color: Theme.flyout-shadow;

    TouchArea { }

    layout := VerticalLayout {
        padding-top: root.inner-padding + root.extra-top - root.focus-overhang;
        padding-bottom: root.inner-padding - root.focus-overhang;
        padding-left: root.plain ? 0px : 1px;
        padding-right: root.plain ? 0px : 1px;

        if root.buttons.length > 0 && !root.buttons-bottom: VerticalLayout {
            padding-left: 4px;
            padding-right: 4px;
            padding-top: 1px;
            HorizontalLayout {
                alignment: start;
                for b[i] in root.buttons: HorizontalLayout {
                    if i > 0: Rectangle {
                        width: 1px;
                        Rectangle {
                            y: 11px;
                            height: 48px;
                            background: Theme.flyout-divider;
                        }
                    }
                    IconButton {
                        button: b;
                        focused: root.keyboard && root.button-hot == i;
                        activated => { root.button(i); }
                    }
                }
            }
            Rectangle { height: 4px; }
            Rectangle {
                height: 1px;
                background: Theme.flyout-separator;
            }
            Rectangle { height: 4px; }
        }

        rows-view := Flickable {
            preferred-width: rows.preferred-width;
            min-width: rows.min-width;
            height: (root.height-limit > 0 ? min(rows.preferred-height, root.height-limit - 2 * root.inner-padding) : rows.preferred-height) + 2 * root.focus-overhang;
            content-height: rows.preferred-height + 2 * root.focus-overhang;

            rows := VerticalLayout {
                y: root.focus-overhang;
                width: rows-view.width;
                spacing: root.row-gap;
                for entry[i] in root.items: MenuRow {
                    nav-options: root.nav-options;
                    entry: entry;
                    row-height: root.row-height;
                    label-x: root.label-x;
                    icon-x: root.icon-x;
                    separator-height: root.separator-height;
                    right-padding: root.right-padding;
                    shortcut-width: root.shortcut-width;
                    hot: root.hot == i || root.open-index == i;
                    keyboard: root.keyboard;
                    hovered => {
                        root.hot = entry.separator ? -1 : i;
                        root.hover-changed(i, self.absolute-position.y);
                    }
                    activated => { root.activated(i); }
                }
            }
        }

        if root.buttons.length > 0 && root.buttons-bottom: VerticalLayout {
            padding-left: 4px;
            padding-right: 4px;
            padding-bottom: 1px;
            Rectangle { height: 4px; }
            Rectangle {
                height: 1px;
                background: Theme.flyout-separator;
            }
            Rectangle { height: 4px; }
            HorizontalLayout {
                spacing: 1px;
                alignment: start;
                for b[i] in root.buttons: IconButton {
                    button: b;
                    focused: root.keyboard && root.button-hot == i;
                    activated => { root.button(i); }
                }
            }
        }
    }
}

export struct PopupData {
    cloud:bool,
    keyboard: bool,
    key-tips: bool,
    items: [MenuEntry],
    buttons: [MenuButton],
    buttons-bottom: bool,
    min-width: length,
    label-x: length,
    icon-x: length,
    separator-height: length,
    padding: length,
    // More room above the first row ("..." starting with Desfazer has 8px more).
    extra-top: length,
    right-padding: length,
    shortcut-width: length,
    nav-options: bool,
    max-height: length,
    row-height: length,
    row-gap: length,
}

export component MenuPopup inherits Window {
    pure callback chrome(int, int, bool, bool) -> image;
    in property <image> chrome-image;
    in property <PopupData> data;
    in property <CloudData> cloud-data;
    callback cloud-command(int);
    property <int> cloud-hot: -1;
    in property <int> open-index: -1;
    in property <int> level;
    callback activated(int);
    callback button(int);
    callback hover(int, length);
    callback dismissed();
    callback key(KeyEvent) -> bool;
    in-out property <bool> keyboard;
    callback key-tips(bool);
    callback focus-button(int);
    in-out property <length> slide-from;
    property <bool> sliding;
    property <duration> slide-start;
    property <float> slide-s: root.sliding ? pow(min(1, max(0, (animation-tick() - root.slide-start) / 250ms)), 1 / 3) : 0;
    property <length> slide: root.slide-from * (1 - (3 - 2 * root.slide-s) * root.slide-s * root.slide-s);
    public function start-slide() {
        root.slide-start = animation-tick();
        root.sliding = true;
    }
    Timer {
        interval: 50ms;
        running: root.sliding;
        triggered => {
            if animation-tick() - root.slide-start >= 250ms {
                root.sliding = false;
                root.slide-from = 0px;
            }
        }
    }

    no-frame: true;
    background: transparent;
    width: root.menu-width + 20px;
    height: root.menu-height + 20px;
    Image {
        y: root.slide;
        width: parent.width;
        height: parent.height;
        source: root.chrome-image.width > 0 ? root.chrome-image : root.chrome(round(root.width / 1px), round(root.height / 1px), Theme.dark, root.data.padding == 4px);
    }
    out property <length> menu-width: root.data.cloud ? 320px : flyout.width;
    out property <length> menu-height: root.data.cloud ? 202px + (root.cloud-data.more == "" ? 0px : 48px) : flyout.height;

    property <int> pending: -1;
    property <length> pending-y;
    property <bool> tips-shown;
    changed keyboard => { root.tips-shown = false;if !root.keyboard {root.cloud-hot=-1;} }

    public function set-hot(i: int) { flyout.hot = i; }
    public function get-hot() -> int { return flyout.hot; }
    public function first-focus() {
        if root.data.cloud {root.keyboard=true;root.cloud-hot=0;return;}
        root.tips-shown = false;
        root.keyboard = true;
        if root.data.buttons.length > 0 {
            flyout.button-hot = 0;
            root.focus-button(0);
            flyout.hot = -1;
        } else { flyout.button-hot = -1; flyout.hot = 0; }
    }

    scope := FocusScope {
        y: root.slide;
        key-pressed(e) => {
            root.keyboard = true;
            if e.text == Key.Escape {
                root.dismissed();
                return accept;
            }
            if root.data.cloud {
                if (e.text == Key.Tab && e.modifiers.shift) || e.text == Key.LeftArrow || e.text == Key.UpArrow {root.cloud-hot = root.cloud-hot <= 0 ? root.cloud-data.commands.length - 1 : root.cloud-hot == 3 ? 1 : root.cloud-hot - 1;return accept;}
                if e.text == Key.Tab || e.text == Key.RightArrow || e.text == Key.DownArrow { root.cloud-hot = root.cloud-hot < 0 ? 0 : root.cloud-hot == 0 ? 1 : root.cloud-hot == 1 ? 3 : root.cloud-hot >= root.cloud-data.commands.length - 1 ? 0 : root.cloud-hot + 1; return accept; }
                if (e.text == Key.Return || e.text == " ") && root.cloud-hot >= 0 {root.cloud-command(root.cloud-hot);return accept;}
                return accept;
            }
            if e.text == Key.LeftArrow && root.level > 0 {
                root.dismissed();
                return accept;
            }
            if e.text == Key.DownArrow || e.text == Key.UpArrow {
                flyout.button-hot = -1;
                let n = root.data.items.length;
                let step = e.text == Key.DownArrow ? 1 : n - 1;
                let raw = flyout.hot < 0 ? (e.text == Key.DownArrow ? 0 : n - 1) : mod(flyout.hot + step, n);
                flyout.hot = n > 0 && root.data.items[raw].separator ? mod(raw + step, n) : raw;
                flyout.reveal(flyout.hot);
                return accept;
            }
            if (e.text == Key.Return || e.text == " ") && flyout.hot >= 0 {
                if !root.data.items[flyout.hot].disabled {
                    if root.data.items[flyout.hot].submenu { root.hover(flyout.hot, 0px); }
                    else { root.activated(flyout.hot); }
                }
                return accept;
            }
            if (e.text == Key.Return || e.text == " ") && flyout.button-hot >= 0 {
                root.button(flyout.button-hot);
                return accept;
            }
            if flyout.button-hot >= 0 && (e.text == Key.RightArrow || e.text == Key.LeftArrow) {
                flyout.button-hot = mod(flyout.button-hot + (e.text == Key.RightArrow ? 1 : root.data.buttons.length - 1), root.data.buttons.length);
                root.focus-button(flyout.button-hot);
                return accept;
            }
            if e.text == Key.RightArrow && flyout.hot >= 0 && root.data.items[flyout.hot].submenu {
                root.hover(flyout.hot, 0px);
                return accept;
            }
            if root.key(e) { return accept; }
            accept
        }

        flyout := Flyout {
            visible:!root.data.cloud;
            x: 10px;
            y: 2px;
            plain: true;
            keyboard: root.keyboard;
            min-menu-width: root.data.min-width;
            label-x: root.data.label-x;
            icon-x: root.data.icon-x;
            separator-height: root.data.separator-height;
            inner-padding: root.data.padding;
            extra-top: root.data.extra-top;
            right-padding: root.data.right-padding;
            shortcut-width: root.data.shortcut-width;
            nav-options: root.data.nav-options;
            height-limit: root.data.max-height;
            row-height: root.data.row-height;
            row-gap: root.data.row-gap;
            items: root.data.items;
            buttons: root.data.buttons;
            buttons-bottom: root.data.buttons-bottom;
            open-index: root.open-index;
            activated(i) => { root.activated(i); }
            button(i) => { root.button(i); }
            hover-changed(i, y) => {
                root.keyboard = false;
                flyout.button-hot = -1;
                root.key-tips(false);
                root.pending = i;
                root.pending-y = y;
            }
        }
        if root.data.cloud: CloudFlyout { x:10px;y:2px;data:root.cloud-data;hot:root.cloud-hot;command(i)=>{root.cloud-command(i);} }
    }

    Timer {
        interval: 1200ms;
        running: root.keyboard && root.data.key-tips && !root.tips-shown;
        triggered => { root.tips-shown = true; root.key-tips(true); }
    }

    Timer {
        interval: 250ms;
        running: root.pending >= 0;
        triggered => {
            root.hover(root.pending, root.pending-y);
            root.pending = -1;
        }
    }

    init => { scope.focus(); }
}

export struct MenuKeyTip { x: length, y: length, label: string }

// KeyTips extend outside the menu's body and region. Their non-activating owned
// surface cannot take menu input or move the keyboard focus.
export component MenuKeyTips inherits Window {
    in property <[MenuKeyTip]> tips;
    in property <length> body-width;
    in property <length> body-height;
    no-frame: true;
    title: "slint-keytips";
    background: transparent;
    width: root.body-width + 40px;
    height: root.body-height + 32px;
    for tip in root.tips: Rectangle {
        x: tip.x;
        y: tip.y;
        width: ceil(text.preferred-width / 1px) * 1px + 8px;
        height: 24px;
        background: Theme.dark ? #767676 : #f2f2f2;
        text := Text {
            text: tip.label;
            font-family: Theme.font-small;
            font-size: 12px;
            color: Theme.dark ? white : black;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component MenuLayer inherits Rectangle {
    property <length> margin: 8px;
    property <int> pending: -1;
    property <length> pending-y;
    property <length> sub-anchor-y;
    property <float> reveal: 0;
    animate reveal { duration: 180ms; easing: cubic-bezier(0, 0, 0, 1); }
    init => {
        root.reveal = 1;
        scope.focus();
    }

    // Light dismiss: a press anywhere outside closes the menu and is swallowed.
    TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down { Shell.menu-dismissed(); }
        }
        scroll-event(e) => { accept }
    }

    scope := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                Shell.menu-dismissed();
                return accept;
            }
            if e.text == Key.DownArrow || e.text == Key.UpArrow {
                let n = Shell.menu-items.length;
                let step = e.text == Key.DownArrow ? 1 : n - 1;
                let raw = main.hot < 0 ? (e.text == Key.DownArrow ? 0 : n - 1) : mod(main.hot + step, n);
                main.hot = n > 0 && Shell.menu-items[raw].separator ? mod(raw + step, n) : raw;
                return accept;
            }
            if (e.text == Key.Return || e.text == " ") && main.hot >= 0 {
                if !Shell.menu-items[main.hot].disabled && !Shell.menu-items[main.hot].submenu {
                    Shell.menu-activated(0, main.hot);
                }
                return accept;
            }
            if e.text == Key.RightArrow && main.hot >= 0 && Shell.menu-items[main.hot].submenu {
                Shell.menu-hover(0, main.hot);
                return accept;
            }
            accept
        }
    }

    Timer {
        interval: 250ms;
        running: root.pending >= 0;
        triggered => {
            root.sub-anchor-y = root.pending-y;
            Shell.menu-hover(0, root.pending);
            root.pending = -1;
        }
    }

    property <length> menu-left: Shell.menu-x + main.width > root.width - root.margin ? max(root.margin, Shell.menu-flip-x - main.width) : Shell.menu-x;

    // Reveals the menu downward while it slides in, leaving room for the shadow.
    clip-box := Rectangle {
        x: root.menu-left - 16px;
        y: Shell.menu-y + main.height > root.height - root.margin ? max(root.margin, root.height - root.margin - main.height) : Shell.menu-y;
        width: main.width + 32px;
        height: (main.height + 32px) * root.reveal;
        clip: true;

        main := Flyout {
            x: 16px;
            y: -12px * (1 - root.reveal);
            items: Shell.menu-items;
            buttons: Shell.menu-buttons;
            buttons-bottom: Shell.menu-buttons-bottom;
            open-index: Shell.sub-open ? Shell.sub-parent : -1;
            activated(i) => { Shell.menu-activated(0, i); }
            button(i) => { Shell.menu-button(i); }
            hover-changed(i, y) => {
                root.pending = i;
                root.pending-y = y;
            }
        }
    }

    if Shell.sub-open: Flyout {
        property <length> right-x: root.menu-left + main.width + 1px;
        x: self.right-x + self.width > root.width - root.margin ? max(root.margin, root.menu-left - 1px - self.width) : self.right-x;
        y: root.sub-anchor-y - 5px + self.height > root.height - root.margin ? max(root.margin, root.height - root.margin - self.height) : root.sub-anchor-y - 5px;
        items: Shell.sub-items;
        activated(i) => { Shell.menu-activated(1, i); }
    }
}
