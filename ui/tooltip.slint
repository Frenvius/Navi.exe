// WinUI tooltips: shown after the pointer rests on a control, hidden on leave or press.
import { Theme } from "theme.slint";

export global Tip {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <bool> pending;
    in-out property <bool> shown;
    // An item's infotip: the classic tooltip, under the pointer.
    in-out property <bool> classic;
}

// A TouchArea that requests a tooltip while hovered.
export component TipArea inherits TouchArea {
    in property <string> tip;
    changed has-hover => {
        if self.has-hover && root.tip != "" {
            Tip.classic = false;
            Tip.text = root.tip;
            Tip.x = self.absolute-position.x + self.mouse-x;
            Tip.y = self.absolute-position.y + self.mouse-y;
            Tip.shown = false;
            Tip.pending = true;
        } else {
            Tip.pending = false;
            Tip.shown = false;
        }
    }
    changed pressed => {
        Tip.pending = false;
        Tip.shown = false;
    }
}

// A list item's infotip ("Tipo: ... / Tamanho: ..."), asked of Rust on hover and shown once
// the pointer rests on the item.
export component ItemTip {
    in property <bool> hover;
    in property <bool> pressed;
    in property <string> tip;
    in property <length> pointer-x;
    in property <length> pointer-y;
    callback request();
    property <bool> mine;
    // A click puts the tip away until the pointer moves again.
    property <bool> armed: true;
    changed pointer-x => { if !root.pressed { root.armed = true; } }
    changed pointer-y => { if !root.pressed { root.armed = true; } }
    changed hover => {
        if self.hover {
            root.request();
        } else if root.mine {
            root.mine = false;
            Tip.shown = false;
            Tip.classic = false;
        }
    }
    changed pressed => {
        root.armed = false;
        if root.mine {
            root.mine = false;
            Tip.shown = false;
            Tip.classic = false;
        }
    }
    Timer {
        interval: 1000ms;
        running: root.hover && root.armed && !root.pressed && !root.mine && root.tip != "";
        triggered => {
            Tip.text = root.tip;
            Tip.x = root.pointer-x - 1px;
            Tip.y = root.pointer-y + 18px;
            Tip.classic = true;
            Tip.pending = false;
            Tip.shown = true;
            root.mine = true;
        }
    }
}

export component TipLayer inherits Rectangle {
    Timer {
        interval: 1000ms;
        running: Tip.pending && !Tip.shown;
        triggered => { Tip.shown = true; }
    }

    // Classic: a square box with a 1px grey border and a hard shadow right and below.
    if Tip.shown && Tip.classic: Rectangle {
        x: min(root.width - self.width - 4px, Tip.x);
        y: Tip.y + self.height > root.height - 4px ? Tip.y - self.height - 22px : Tip.y;
        width: classic-text.preferred-width + 11px;
        height: classic-text.preferred-height + 2px;
        background: Theme.tip;
        border-width: 1px;
        border-color: Theme.tip-border;
        drop-shadow-offset-x: 2px;
        drop-shadow-offset-y: 2px;
        drop-shadow-blur: 3px;
        drop-shadow-color: Theme.tip-shadow;
        classic-text := Text {
            x: 5px;
            y: 1px;
            text: Tip.text;
            font-family: Theme.font-dui;
            font-size: 12px;
            color: Theme.tip-text;
        }
    }

    if Tip.shown && !Tip.classic: Rectangle {
        property <length> margin: 8px;
        x: min(root.width - self.width - self.margin, max(self.margin, Tip.x - self.width / 2));
        y: Tip.y + 24px + self.height > root.height - self.margin ? Tip.y - self.height - 8px : Tip.y + 24px;
        width: text.preferred-width + 18px;
        height: text.preferred-height + 12px;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.xaml-tip-border;
        background: Theme.xaml-tip;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: Theme.flyout-shadow;
        text := Text {
            x: 9px;
            y: 5px;
            text: Tip.text;
            font-family: Theme.font-small;
            font-size: 12px;
            color: Theme.text;
        }
    }
}

// A menu item's description (the CommandStore's), a WinUI tooltip in a window of its own so
// that it can lie over the menu. Measured: Segoe UI Variable Small 12px from 10px in, the box
// ceil(text + 16.4) wide ("Selecionar todos os itens na exibição.", 205.4px, makes 222), a
// line 32px tall, wrapped past a 318px box; the system draws its backdrop, corners, border.
export component TipPopup inherits Window {
    in property <string> text;
    // The text's width as DirectWrite lays it out (one line).
    in property <length> text-width;
    no-frame: true;
    background: transparent;
    property <length> line-width: min(301.6px, root.text-width);
    out property <length> tip-width: ceil((root.line-width + 16.4px) / 1px) * 1px;
    out property <length> tip-height: label.preferred-height + 16px;
    width: root.tip-width;
    height: root.tip-height;
    Rectangle {
        background: Theme.xaml-tip;
        label := Text {
            x: 10px;
            y: 8px;
            width: root.line-width + 2px;
            text: root.text;
            font-family: Theme.font-small;
            font-size: 12px;
            color: Theme.text;
            wrap: word-wrap;
        }
    }
}
