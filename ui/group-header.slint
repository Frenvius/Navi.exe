import { Theme } from "theme.slint";
import { Shell } from "shell.slint";

// A group's header ("Anteriormente neste mês", "A – E") in the details and icon views: a
// chevron and the group's name in 15px DirectUI text.
export component GroupHeader inherits Rectangle {
    in property <string> label;
    property <string> subtitle: Shell.group-subtitle(root.label);
    in property <int> index;
    in property <bool> list-focus;
    // Hover and focus span the visible list, from its left edge.
    in property <length> plate-width;
    // The grouped list: no chevron, the name from 6px.
    in property <bool> chevron: true;
    // Collapsed: the chevron points right and the group's items are hidden.
    in property <bool> collapsed;
    in property <bool> highlight-collapsed-focus;
    in property <bool> empty;
    callback focus-list();
    height: root.subtitle == "" ? 32px : 50px;
    Rectangle {
        x: 0;
        y: 4px;
        width: root.plate-width;
        height: root.subtitle == "" ? 27px : 45px;
        background: touch.has-hover || (root.highlight-collapsed-focus && root.collapsed && root.list-focus && Shell.focused-group == root.index) ? Theme.group-hover : transparent;
        border-width: root.list-focus && Shell.focused-group == root.index ? 1px : 0px;
        border-color: Theme.group-focus;
    }
    touch := TouchArea {
        x: 0;
        y: 4px;
        width: root.plate-width;
        height: root.subtitle == "" ? 27px : 45px;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.focus-list();
                if !root.empty { Shell.group-clicked(root.index, e.modifiers.control); }
            }
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
                root.focus-list();
                Shell.group-context(root.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    // A 1px chevron, 11 by 6.
    if root.chevron && !root.collapsed: Path {
        x: 6px;
        y: 13px;
        width: 12px;
        height: 7px;
        viewbox-width: 12;
        viewbox-height: 7;
        commands: "M -0.5 0.6 L 5.3 6.4 L 11.1 0.6";
        stroke: Theme.chevron;
        stroke-width: 1.3px;
    }
    if root.chevron && root.collapsed: Path {
        x: 9px;
        y: 10px;
        width: 7px;
        height: 12px;
        viewbox-width: 7;
        viewbox-height: 12;
        commands: "M 0.6 -0.5 L 6.4 5.3 L 0.6 11.1";
        stroke: Theme.chevron;
        stroke-width: 1.3px;
    }
    // The chevron opens and closes the group instead of selecting it.
    if root.chevron: TouchArea {
        x: root.subtitle == "" ? 0px : 6px;
        y: 4px;
        width: root.subtitle == "" ? 21px : 15px;
        height: root.subtitle == "" ? 27px : 45px;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.focus-list();
                if root.empty { Shell.library-empty-toggled(root.label); }
                else { Shell.group-toggled(root.index); }
            }
        }
    }
    label := Text {
        x: root.chevron ? 21px : 6px;
        y: root.subtitle == "" ? 0px : 2px;
        height: 32px;
        text: Shell.group-title(root.label);
        font-family: Theme.font-dui;
        font-size: 15px;
        color: Theme.group-text;
        vertical-alignment: center;
        changed preferred-width => { if !root.empty { Shell.header-width(root.index, self.preferred-width); } }
        init => { if !root.empty { Shell.header-width(root.index, self.preferred-width); } }
    }
    if root.subtitle != "": Text {
        x: root.chevron ? 21px : 6px;
        y: 27px;
        width: root.plate-width - self.x - 4px;
        height: 18px;
        text: root.subtitle;
        font-family: Theme.font-dui;
        font-size: 12px;
        color: Theme.dui-text;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component EmptyLibraryHeader inherits Rectangle {
    in property <string> label;
    in property <bool> folded;
    in property <bool> chevron: true;
    height: root.folded ? 48px : 82px;
    GroupHeader {
        x: 0;
        y: 0;
        label: root.label;
        empty: true;
        index: -1;
        collapsed: root.folded;
        chevron: root.chevron;
        plate-width: root.width - 18px;
    }
    if !root.folded: Text {
        y: 50px;
        height: 33px;
        width: parent.width;
        text: Shell.empty-text;
        font-family: Theme.font-dui;
        font-size: 12px;
        color: Theme.dui-text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
