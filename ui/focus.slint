import { Theme } from "theme.slint";

// XAML focus visual: a 2px outer stroke with a 1px inner stroke.
export component KeyboardRing inherits Rectangle {
    in property <length> radius: 7px;
    in property <bool> flat-bottom;
    border-radius: root.radius;
    border-bottom-left-radius: root.flat-bottom ? 0px : root.radius;
    border-bottom-right-radius: root.flat-bottom ? 0px : root.radius;
    border-width: 2px;
    border-color: Theme.focus-outer;
    Rectangle {
        x: 2px; y: 2px;
        width: parent.width - 4px; height: parent.height - 4px;
        border-radius: max(0px,root.radius - 2px);
        border-bottom-left-radius: root.flat-bottom ? 0px : max(0px,root.radius - 2px);
        border-bottom-right-radius: root.flat-bottom ? 0px : max(0px,root.radius - 2px);
        border-width: 1px;
        border-color: Theme.focus-inner;
    }
}
