import { Theme, Glyphs, Glyph } from "theme.slint";
import { Shell } from "shell.slint";
import { KeyboardRing } from "focus.slint";

component SettingSwitch inherits Rectangle {
    in property <bool> checked;
    callback toggled();
    width: 40px;
    height: 20px;
    border-radius: 10px;
    border-width: root.checked ? 0px : 1px;
    border-color: Theme.text-secondary;
    background: root.checked ? Theme.accent : touch.has-hover ? Theme.subtle-hover : transparent;
    accessible-role: checkbox;
    accessible-label: @tr("settings.default.title");
    accessible-checked: root.checked;
    forward-focus: scope;
    scope := FocusScope {
        changed has-focus => { if self.has-focus { Shell.focus-noted("settings-toggle"); } }
        key-pressed(e) => {
            if e.text == " " || e.text == Key.Return { root.toggled(); return accept; }
            reject
        }
    }
    if scope.has-focus: KeyboardRing { x:-3px;y:-3px;width:parent.width+6px;height:parent.height+6px;radius:12px; }
    Rectangle {
        x: root.checked ? 24px : 4px;
        y: 4px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: root.checked ? (Theme.dark ? #003e50 : #ffffff) : Theme.text-secondary;
    }
    touch := TouchArea { clicked => { scope.focus(); root.toggled(); } }
    public function focus-toggle() { scope.focus(); }
}

export component SettingsView inherits Rectangle {
    background: Theme.pane;
    public function focus-toggle() { toggle.focus-toggle(); }
    public function focus-section() { section.focus(); }
    public function focus-restore() { restore-focus.focus(); }
    Timer { interval: 1s; running: Shell.settings-view; triggered => { Shell.settings-refresh(); } }
    // Sections are data, so adding another section does not change the surrounding layout.
    property <[{title:string,glyph:string}]> sections: [{title:@tr("settings.general"),glyph:Glyphs.settings}];
    Rectangle {
        x:0px;y:0px;
        width: root.width < 700px ? 156px : 208px;
        height: parent.height;
        Text { x:24px;y:24px;height:32px;width:parent.width - 36px;text:@tr("settings.title");font-size:20px;font-weight:600;color:Theme.text;overflow:elide; }
        for item[i] in root.sections: Rectangle {
            x:12px;y:76px+i*44px;width:parent.width - 24px;height:36px;border-radius:4px;
            background: Theme.subtle-hover;
            Rectangle { x:0px;y:10px;width:3px;height:16px;border-radius:1.5px;background:Theme.accent; }
            Glyph { x:12px;width:20px;text:item.glyph; }
            Text { x:44px;width:parent.width - 52px;height:parent.height;text:item.title;color:Theme.text;vertical-alignment:center;overflow:elide; }
            if section.has-focus: KeyboardRing { x:-2px;y:-2px;width:parent.width+4px;height:parent.height+4px; }
            TouchArea { clicked => { section.focus(); } }
        }
        section := FocusScope {
            width:0px;height:0px;
            changed has-focus => {if self.has-focus {Shell.focus-noted("settings-section");}}
        }
    }
    Flickable {
        x:root.width < 700px ? 156px : 208px;
        width:parent.width - self.x;
        height:parent.height;
        content-width:self.width;
        content-height:max(self.height, card.y+card.height+32px);
        Text { x:28px;y:24px;width:parent.width - 56px;height:40px;text:@tr("settings.general");font-size:28px;font-weight:600;color:Theme.text; }
        card := Rectangle {
            x:28px;y:84px;width:parent.width - 56px;
            height:max(116px, description.y+description.height+20px) + (Shell.default-error != "" ? error.height+12px : 0px) + (Shell.default-recovery && !Shell.default-enabled ? 44px : 0px);
            border-radius:4px;background:Theme.settings-card;border-width:1px;border-color:Theme.card-border;
            Glyph { x:20px;y:24px;width:24px;height:24px;text:"\u{e8b7}";font-size:24px; }
            Text { x:64px;y:20px;width:parent.width - 144px;height:self.preferred-height;text:@tr("settings.default.title");font-size:14px;color:Theme.text;wrap:word-wrap; }
            description := Text {
                x:64px;y:24px+title-size.preferred-height;width:parent.width - 144px;
                text:@tr("settings.default.description");font-size:12px;color:Theme.text-secondary;wrap:word-wrap;
            }
            // The hidden measuring text keeps the description below a wrapped title.
            title-size := Text { visible:false;width:parent.width - 144px;text:@tr("settings.default.title");font-size:14px;wrap:word-wrap; }
            toggle := SettingSwitch { x:parent.width - 60px;y:32px;checked:Shell.default-enabled;toggled=>{Shell.default-toggle(!Shell.default-enabled);} }
            error := Text {
                visible:Shell.default-error != "";
                x:64px;y:description.y+description.height+12px;width:parent.width - 84px;
                text:Shell.default-error;color:Theme.settings-error;font-size:12px;wrap:word-wrap;
            }
            if Shell.default-recovery && !Shell.default-enabled: Rectangle {
                x:64px;y:parent.height - 40px;width:min(240px,parent.width - 84px);height:28px;border-radius:4px;
                border-width:1px;border-color:Theme.control-border;
                background:restore-touch.pressed?Theme.control-pressed:restore-touch.has-hover?Theme.control-hover:Theme.control;
                Text {text:@tr("settings.default.restore");color:Theme.text;font-size:12px;horizontal-alignment:center;vertical-alignment:center;}
                if restore-focus.has-focus: KeyboardRing {x:-2px;y:-2px;width:parent.width+4px;height:parent.height+4px;}
                restore-touch := TouchArea {clicked=>{Shell.default-toggle(false);}}
            }
            restore-focus := FocusScope {
                width:0px;height:0px;
                changed has-focus=>{if self.has-focus{Shell.focus-noted("settings-restore");}}
                key-pressed(e)=>{if e.text==" " || e.text==Key.Return{Shell.default-toggle(false);return accept;}reject}
            }
        }
    }
}
