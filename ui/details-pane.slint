// Details pane (Alt+Shift+P): preview, name, share button and the item's main properties.
import { Theme } from "theme.slint";
import { Shell, Icons } from "shell.slint";
import { KeyboardRing } from "focus.slint";

export struct DetailRow {
    label: string,
    value: string,
}

export global Pane {
    in property <image> preview;
    // A file with a thumbnail (a picture, a video) fills the preview area with it.
    in property <bool> preview-large;
    in property <image> icon;
    in property <string> name;
    // The name comes broken into its lines (DirectWrite's, as the real's XAML breaks them).
    in property <int> name-lines: 1;
    in property <[DetailRow]> rows;
    in property <bool> can-share;
    in property <bool> can-properties: true;
    // Shown in a card instead of the details when nothing is selected.
    in property <string> info;
    in property <image> share-icon;
    in property <image> properties-icon;
    callback share();
    callback properties();
}

component PaneButton inherits Rectangle {
    in property <bool> focused;
    in property <image> icon;
    in property <string> label;
    callback clicked();
    width: 12px + 16px + 8px + text.preferred-width + 12px;
    height: 29px;
    border-radius: 4px;
    // The fill stops inside the border (XAML's InnerBorderEdge), which lies on the pane.
    border-width: 1px;
    border-color: Theme.control-elevation-border;
    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-radius: 3px;
        background: touch.pressed ? Theme.control-pressed : touch.has-hover ? Theme.control-hover : Theme.control;
    }
    Image {
        x: 12px;
        y: 6px;
        width: 16px;
        height: 16px;
        source: root.icon;
    }
    text := Text {
        x: 12px + 16px + 8px;
        height: parent.height;
        text: root.label;
        font-family: Theme.font-small;
        font-size: 12px;
        color: touch.pressed ? Theme.text-secondary : Theme.text;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    if root.focused: KeyboardRing { x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; }
}

export component DetailsPane inherits Rectangle {
    background: Theme.content;
    property <string> focused-button: "pane-properties";
    public function focus-button(id: string) { root.focused-button = id; scope.focus(); Shell.focus-noted(id); }
    scope := FocusScope {
        changed has-focus => { if self.has-focus { Shell.focus-noted(root.focused-button); } }
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " {
                if root.focused-button == "pane-share" { Pane.share(); } else { Pane.properties(); }
                return accept;
            }
            reject
        }
    }

    // Splitter, as between the navigation pane and the view.
    Rectangle {
        x: 0;
        width: 3px;
        HorizontalLayout {
            Rectangle { width: 1px; background: Theme.splitter-outer; }
            Rectangle { width: 1px; background: Theme.splitter-mid; }
            Rectangle { width: 1px; background: Theme.splitter-outer; }
        }
    }

    body := Rectangle {
        x: 3px;
        width: parent.width - 3px;

        // Preview
        Rectangle {
            y: 0;
            height: 220px;
            background: Theme.pane;
            // An icon is 96px, centred; a thumbnail is fitted to the whole area (small ones
            // grow), centred on whole pixels.
            property <float> fit: Pane.preview.width > 0 ? min(self.width / 1px / Pane.preview.width, self.height / 1px / Pane.preview.height) : 1;
            property <length> fit-w: round(Pane.preview.width * fit) * 1px;
            property <length> fit-h: round(Pane.preview.height * fit) * 1px;
            // Centred by the exact fitted size (864x576 is 199.33 tall: 10px down, not 11).
            Image {
                x: Pane.preview-large ? round((parent.width / 1px - Pane.preview.width * parent.fit) / 2) * 1px : (parent.width - 96px) / 2;
                y: Pane.preview-large ? round((parent.height / 1px - Pane.preview.height * parent.fit) / 2) * 1px : (parent.height - 96px) / 2;
                width: Pane.preview-large ? parent.fit-w : 96px;
                height: Pane.preview-large ? parent.fit-h : 96px;
                source: Pane.preview;
                image-fit: contain;
            }
        }

        // The title wraps at words, 21.25px a line, its first line staying put. With an icon
        // the block is n x 21.25 + 6.5 tall (32 at least) and the icon centres on it; without
        // one each line adds its height. What follows moves down by as much.
        // Its lines come broken to 216px (256 without an icon); the box only elides.
        property <length> title-width: body.width - 59px - 20px + (Pane.icon.width > 0 ? 0px : 40px);
        property <int> title-lines: Pane.name-lines;
        property <length> title-shift: body.title-lines <= 1 ? 0px
            : Pane.icon.width > 0 ? max(0px, round(body.title-lines * 21.25 + 6.5 - 32) * 1px)
            : round((body.title-lines - 1) * 21.25) * 1px;
        Image {
            x: 20px;
            y: 243px + round(parent.title-shift / 2px) * 1px;
            // The shell's 32px icon occupies a 30px image beside the title.
            width: 30px;
            height: 30px;
            source: Pane.icon;
            image-rendering: pixelated;
        }
        title := Text {
            x: Pane.icon.width > 0 ? 61px : 21px;
            y: parent.title-lines > 1 ? 246.75px : 241px;
            width: parent.title-width;
            height: parent.title-lines > 1 ? self.preferred-height : 32px;
            text: Pane.name;
            font-family: Theme.font-text;
            font-size: 16px;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: parent.title-lines > 1 ? top : center;
            wrap: no-wrap;
            overflow: elide;
        }

        if Pane.info != "": Rectangle {
            x: 21px;
            y: 284px + parent.title-shift;
            width: parent.width - 21px - 21px;
            height: info-text.preferred-height + 26px;
            border-radius: 4px;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.card-border;
            Text {
                x: 14px;
                width: 16px;
                height: parent.height;
                text: "\u{F167}";
                font-family: Theme.font-icons;
                font-size: 16px;
                color: Theme.text-secondary;
                vertical-alignment: center;
            }
            info-text := Text {
                x: 41px;
                y: 13px;
                width: parent.width - 41px - 14px;
                text: Pane.info;
                font-family: Theme.font-text;
                font-size: 14px;
                color: Theme.text;
                wrap: word-wrap;
            }
        }

        if Pane.can-share: PaneButton {
            focused: scope.has-focus && root.focused-button == "pane-share";
            x: 21px;
            y: 288px + parent.title-shift;
            icon: Pane.share-icon;
            label: @tr("cmd.share");
            clicked => { Pane.share(); }
        }

        // Without the sharing button (a folder) the details come up in its place.
        property <length> details-y: (Pane.can-share ? 0px : -65px) + body.title-shift;
        if Pane.rows.length > 0: Text {
            x: 21px;
            y: 349px + parent.details-y;
            text: @tr("cmd.details");
            font-family: Theme.font-small;
            font-size: 12px;
            font-weight: 600;
            color: Theme.text;
        }

        for row[i] in Pane.rows: Rectangle {
            x: 21px;
            y: 375px + parent.details-y + i * 22px;
            width: parent.width - 21px - 21px;
            height: 20px;
            label := Text {
                x: 0;
                // The label column is 86px wide, trimming longer labels ("Local do arqui…").
                width: 86px;
                height: parent.height;
                text: row.label;
                font-family: Theme.font-small;
                font-size: 12px;
                color: Theme.text-secondary;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                // 6px from the label column (an elided value starts there).
                x: label.width + 6px;
                width: parent.width - self.x;
                height: parent.height;
                text: row.value;
                font-family: Theme.font-small;
                font-size: 12px;
                color: Theme.text;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        if Pane.can-properties: PaneButton {
            focused: scope.has-focus && root.focused-button == "pane-properties";
            x: 21px;
            y: 375px + parent.details-y + Pane.rows.length * 22px + 15px;
            icon: Pane.properties-icon;
            label: @tr("menu.properties");
            clicked => { Pane.properties(); }
        }
    }
}
