// Navigation row (y 40-88): history buttons, breadcrumb address bar and search box.
import { Theme, Glyphs, Glyph } from "theme.slint";
import { Shell, Icons, Crumb } from "shell.slint";
import { TipArea } from "tooltip.slint";
import { KeyboardRing } from "focus.slint";

component NavButton inherits Rectangle {
    in property <string> focus-id;
    in property <string> glyph;
    in property <length> glyph-size: 12px;
    in property <bool> enabled: true;
    in property <string> tip;
    callback clicked();
    // A right-click, at the pointer (window coordinates).
    callback context(length, length);
    width: 32px;
    height: 32px;
    border-radius: 4px;
    background: !root.enabled ? transparent : touch.pressed ? Theme.subtle-pressed : touch.has-hover ? Theme.subtle-hover : transparent;
    property <bool> wants-focus: Shell.nav-focus == root.focus-id;
    changed wants-focus => { if self.wants-focus { scope.focus(); } }
    property <int> request: Shell.nav-focus-request;
    changed request => { if root.wants-focus { scope.focus(); } }
    scope := FocusScope {
        changed has-focus => { if self.has-focus { Shell.focus-noted(root.focus-id); } }
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " { root.clicked(); return accept; }
            reject
        }
    }
    if scope.has-focus: KeyboardRing { x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; }
    Glyph {
        text: root.glyph;
        font-size: root.glyph-size;
        color: !root.enabled ? Theme.text-disabled : touch.pressed ? Theme.text-secondary : Theme.text;
    }
    touch := TipArea {
        enabled: root.enabled;
        tip: root.tip;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
                root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

// The keyboard focus ring: 2px white, a black pixel inside.
component FocusRing inherits Rectangle {
    border-radius: 5px;
    border-width: 2px;
    border-color: Theme.focus-outer;
    Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-radius: 3px;
        border-width: 1px;
        border-color: Theme.focus-inner;
    }
}

component CrumbButton inherits Rectangle {
    callback clicked();
    // A right-click, at the pointer (window coordinates).
    callback context(length, length);
    out property <bool> pressed: touch.pressed;
    out property <bool> hovered: touch.has-hover && !Shell.menu-open;
    in property <bool> held;
    // Part of a crumb split button, which draws the plates itself.
    in property <bool> plain;
    height: 24px;
    border-radius: 4px;
    // An open menu takes the pointer: nothing else in the bar lights up meanwhile.
    background: root.plain ? transparent : root.held ? Theme.menu-held : touch.pressed ? Theme.subtle-pressed : touch.has-hover && !Shell.menu-open ? Theme.subtle-hover : transparent;
    touch := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
                root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

component Chevron inherits CrumbButton {
    in property <int> index;
    in property <length> glyph-shift;
    // Narrows the box the glyph centres in (a 23px chevron would centre it on a half pixel).
    in property <length> glyph-trim;
    // Where its dropdown's left edge goes, from its own.
    in property <length> menu-dx;
    // Its dropdown is open: it points down and keeps a plate.
    out property <bool> open: Shell.menu-open && Shell.menu-owner == "crumbs" && Shell.crumb-open == root.index;
    held: root.open;
    width: 26px;
    // Open, the same chevron turns to point down.
    Glyph {
        x: root.glyph-shift;
        height: Shell.native-shell-view ? parent.height : self.preferred-height;
        y: Shell.native-shell-view ? 1px : (parent.height - self.height)/2;
        width: parent.width - root.glyph-trim;
        text: Glyphs.chevron-right-med;
        font-size: Shell.native-shell-view ? 10px : 12px;
        transform-rotation: root.open ? 90deg : 0deg;
    }
    clicked => {
        Shell.crumb-menu(root.index, self.absolute-position.x + root.menu-dx, self.absolute-position.y + self.height + 3px);
    }
}

// A crumb is a split button: 9px, label, 9px, then a 23px chevron. Hovering one part fills
// it (taking the shared edge pixel) and outlines the other; only the outer corners round.
component CrumbItem inherits Rectangle {
    in property <Crumb> crumb;
    in property <int> index;
    // The keyboard focus is on it: the ring reaches 2px past it each side.
    in property <bool> ring;
    property <length> label-width: text.preferred-width + (Shell.native-shell-view ? 0px : 18px);
    out property <length> measured: root.label-width + (root.crumb.chevron ? (Shell.native-shell-view ? 22px : 23px) : 0px);
    changed measured => { Shell.crumb-width(root.index, root.measured); }
    init => {
        Shell.crumb-width(root.index, root.measured);
        Shell.crumb-spot(root.index, self.absolute-position.x, self.absolute-position.y);
    }
    changed x => { Shell.crumb-spot(root.index, self.absolute-position.x, self.absolute-position.y); }
    property <bool> on-label: label.hovered || label.pressed;
    property <bool> on-chevron: root.crumb.chevron && (chevron.hovered || chevron.pressed);
    // With its dropdown open only the chevron keeps a plate.
    property <bool> open: root.crumb.chevron && chevron.open;
    property <bool> lit: (root.on-label || root.on-chevron) && !root.open;
    height: 24px;

    // The label's plate and the chevron's share one pixel, which goes to the hovered part:
    // it is filled and the other outlined, the outline cut short of that pixel.
    if root.lit && root.on-label: Rectangle {
        x: 0;
        width: root.label-width;
        border-top-left-radius: 4px;
        border-bottom-left-radius: 4px;
        border-top-right-radius: root.crumb.chevron ? 0px : 4px;
        border-bottom-right-radius: root.crumb.chevron ? 0px : 4px;
        background: label.pressed ? Theme.subtle-pressed : Theme.subtle-hover;
    }
    if root.lit && !root.on-label: Rectangle {
        x: 0;
        width: root.label-width - 1px;
        clip: true;
        Rectangle {
            x: 0;
            width: root.label-width;
            border-top-left-radius: 4px;
            border-bottom-left-radius: 4px;
            border-width: 1px;
            border-color: Theme.subtle-hover;
        }
    }
    if root.lit && root.on-chevron: Rectangle {
        x: root.label-width - 1px;
        width: 24px;
        border-top-right-radius: 4px;
        border-bottom-right-radius: 4px;
        background: chevron.pressed ? Theme.subtle-pressed : Theme.subtle-hover;
    }
    if root.lit && root.crumb.chevron && !root.on-chevron: Rectangle {
        x: root.label-width;
        width: Shell.native-shell-view ? 22px : 23px;
        clip: true;
        Rectangle {
            x: -1px;
            width: 24px;
            border-top-right-radius: 4px;
            border-bottom-right-radius: 4px;
            border-width: 1px;
            border-color: Theme.subtle-hover;
        }
    }
    // A drag over it lights the whole crumb.
    if Shell.crumb-drop == root.index: Rectangle {
        width: root.label-width + (root.crumb.chevron ? (Shell.native-shell-view ? 22px : 23px) : 0px);
        border-radius: 4px;
        background: Theme.subtle-hover;
    }
    // The current (last) one's ring leaves its chevron out.
    if root.ring: FocusRing {
        x: -2px;
        width: (root.index == Shell.crumbs.length - 1 ? root.label-width : root.measured) + 4px;
        height: 24px;
    }

    // Open, the chevron alone keeps a smaller plate.
    if root.open: Rectangle {
        x: root.label-width;
        y: 1px;
        width: 22px;
        height: 22px;
        border-radius: 4px;
        background: Theme.menu-held;
    }
    label := CrumbButton {
        plain: true;
        x: 0;
        width: root.label-width;
        text := Text {
            x: Shell.native-shell-view ? 0px : 9px;
            y: Shell.native-shell-view ? 1px : 0px;
            height: 22px;
            text: root.crumb.name;
            font-family: Shell.native-shell-view ? "Segoe UI" : Theme.font-text;
            font-size: Shell.native-shell-view ? 12px : 14px;
            color: Theme.text;
            vertical-alignment: center;
        }
        clicked => { Shell.navigate-crumb(root.index); }
        context(x, y) => { Shell.address-context(x, y); }
    }
    chevron := Chevron {
        visible: root.crumb.chevron;
        plain: true;
        x: root.label-width;
        width: Shell.native-shell-view ? 22px : 23px;
        // XAML lands the glyph half a pixel left of centre, the last one half right.
        glyph-trim: 1px;
        glyph-shift: !Shell.native-shell-view && root.index == Shell.crumbs.length - 1 ? 1px : 0px;
        // The dropdown lines up with the chevron's plate, which starts a pixel early.
        menu-dx: -1px;
        index: root.index;
        context(x, y) => { Shell.address-context(x, y); }
    }
}

// A suggestion under the address being edited: a 40px row whose plate (hovered, or picked
// with the arrow keys, which also marks it with the accent) is inset 4px and 2px.
component SuggestionRow inherits Rectangle {
    in property <string> text;
    in property <bool> picked;
    callback clicked();
    height: 40px;

    if touch.has-hover || root.picked: Rectangle {
        x: 4px;
        y: 2px;
        width: parent.width - 8px;
        height: 36px;
        border-radius: 4px;
        background: touch.pressed ? Theme.subtle-pressed : Theme.subtle-hover;
    }
    if root.picked: Rectangle {
        x: 4px;
        y: 12px;
        width: 3px;
        height: 16px;
        border-radius: 1.5px;
        background: Theme.accent;
    }
    Text {
        x: 15px;
        width: parent.width - 31px;
        height: parent.height;
        text: root.text;
        font-size: 14px;
        color: Theme.text;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Address inherits Rectangle {
    property <length> cloud-width:94px;
    property <bool> editing;
    // The text as typed, which the arrow keys come back to past the last suggestion.
    property <string> typed;
    property <bool> listing: root.editing && Shell.suggestions.length > 0;
    border-radius: Shell.native-shell-view ? 0px : 4px;
    height: Shell.native-shell-view ? 34px : 32px;
    // Unlike the search box, the address bar keeps its colour under the pointer; edited, it
    // darkens and takes a hairline border.
    background: Shell.native-shell-view ? (Theme.dark ? #191919 : #ffffff) : root.editing ? Theme.address-edit : Theme.control;
    border-width: Shell.native-shell-view || root.editing ? 1px : 0px;
    border-color: Shell.native-shell-view ? (Theme.dark ? #535353 : #b0b0b0) : Theme.address-border;

    public function edit() {
        Shell.focus-noted("address");
        root.edit-text();
        input.select-all();
        // A long path shows its end, as Explorer's: once the box has laid the text out, the
        // caret goes to the end (all still selected).
        to-end.running = true;
        Shell.address-edit-started(input.text);
    }

    // Editing with nothing selected and no suggestions yet (from a right-click).
    function edit-text() {
        root.editing = true;
        input.text = Shell.address-text;
        root.typed = input.text;
        input.focus();
        input.set-selection-offsets(1000000, 1000000);
    }

    // Leaves editing for the crumbs, the keyboard focus on the root button.
    function cancel() {
        root.editing = false;
        root.kb-at = -1;
        root-focus.focus();
        Shell.focus-noted("crumbs");
    }
    public function focus-crumb() { root.cancel(); }

    changed editing => {
        if !root.editing {
            Shell.suggestions = [];
            Shell.suggest-index = -1;
        }
    }

    // Moves the arrow keys' pick through the suggestions, by way of the text as typed.
    function pick(step: int) {
        let n = Shell.suggestions.length;
        if n == 0 { return; }
        let at = Shell.suggest-index + step;
        Shell.suggest-index = at >= n ? -1 : at < -1 ? n - 1 : at;
        input.text = Shell.suggest-index >= 0 ? Shell.suggestions[Shell.suggest-index] : root.typed;
        input.set-selection-offsets(1000000, 1000000);
        let row = Shell.suggest-index * 40px;
        if Shell.suggest-index >= 0 && row < -rows.content-y {
            rows.content-y = -row;
        } else if Shell.suggest-index >= 0 && row + 40px > -rows.content-y + rows.height {
            rows.content-y = -(row + 40px - rows.height);
        }
    }

    // The keyboard focus in the bar (left there by Escape): on the root button (-1), the
    // overflow button (-2) or a crumb; the arrow keys move it, Enter or Space presses it and
    // Tab goes on to the search box.
    callback tab-out();
    property <int> kb-at: -1;
    property <bool> kb: root-focus.has-focus && !root.editing;

    function kb-move(step: int) {
        let n = Shell.crumbs.length;
        let h = Shell.hidden-crumbs;
        let more = h > 0 ? 1 : 0;
        let at = root.kb-at == -1 ? 0 : root.kb-at == -2 ? 1 : more + 1 + root.kb-at - h;
        let to = max(0, min(more + n - h, at + step));
        root.kb-at = to == 0 ? -1 : (more == 1 && to == 1) ? -2 : h + to - 1 - more;
    }

    function kb-press() {
        if root.kb-at == -1 {
            if Shell.cloud.label != "" {Shell.cloud-open(root.absolute-position.x+3px,root.absolute-position.y+38px,true);}
            else {Shell.crumb-menu(-1, root.absolute-position.x + 13px + 25px, root.absolute-position.y + 4px + 24px + 3px);}
        } else if root.kb-at >= 0 {
            Shell.navigate-crumb(root.kb-at);
        }
    }

    root-focus := FocusScope {
        x: 2px;
        width: Shell.cloud.label != "" ? root.cloud-width + 26px : 62px;
        height: 32px;
        changed has-focus => { if self.has-focus { Shell.focus-noted("crumbs"); } }
        key-pressed(e) => {
            if e.text == Key.RightArrow { root.kb-move(1); return accept; }
            if e.text == Key.LeftArrow { root.kb-move(-1); return accept; }
            if e.text == Key.Return || e.text == " " { root.kb-press(); return accept; }
            if e.text == Key.Tab && !e.modifiers.shift { root.tab-out(); return accept; }
            reject
        }
        if root.kb && root.kb-at == -1: FocusRing { }
    }

    touch := TouchArea {
        enabled: !root.editing;
        clicked => { root.edit(); }
        pointer-event(e) => {
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
                root.edit-text();
                Shell.address-text-context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    // What Rust asks of the field (see Shell.address-command).
    property <int> command: Shell.address-command;
    changed command => {
        if root.command == 1 { input.cut(); }
        if root.command == 2 { input.copy(); }
        if root.command == 3 { input.paste(); }
        if root.command == 4 { input.select-all(); }
        if root.command == 5 { root.edit(); }
        if root.command != 0 { Shell.address-command = 0; }
    }

    if !root.editing: Rectangle {
        x: Shell.native-shell-view ? 9px : 13px;
        width: parent.width - (Shell.native-shell-view ? 9px : 13px) - 4px;

        root-icon := Rectangle {
            visible:Shell.cloud.label == "" || Shell.native-shell-view;
            x: 0;
            y: Shell.native-shell-view ? 8px : (parent.height - self.height)/2;
            width: 16px;
            height: 16px;
            Image {
                visible: Shell.native-shell-view || (Shell.root-kind != 5 && Shell.root-kind != 6);
                source: Shell.native-shell-view ? Shell.native-location-icon : Shell.root-kind == 1 ? Icons.desktop : Shell.root-kind == 2 ? Icons.home : Shell.root-kind == 3 ? Icons.gallery : Shell.root-kind == 4 ? Icons.network : Shell.root-icon;
                width: 16px;
                height: 16px;
            }
            if Shell.root-kind == 6: Glyph {text:Glyphs.settings;width:16px;height:16px;font-size:14px;}
            // Explorer draws This PC's glyph smaller and in the secondary text colour.
            if !Shell.native-shell-view && Shell.root-kind == 5: Glyph {
                y: -1px;
                height: 16px;
                text: Glyphs.this-pc;
                font-size: Shell.native-shell-view ? 12px : 14px;
                color: Theme.text-secondary;
            }
        }
        cloud := CrumbButton {
            visible:Shell.cloud.label != "" && !Shell.native-shell-view;
            x:-10px;y:4px;
            width:cloud-label.preferred-width + 42px;height:24px;
            changed width=>{root.cloud-width=self.width;}
            init=>{root.cloud-width=self.width;}
            Image {x:8px;y:4px;width:16px;height:16px;source:Shell.cloud.icon;}
            cloud-label:=Text {x:32px;y:-1px;height:24px;text:Shell.cloud.label;font-family:Theme.font-text;font-size:14px;color:Theme.text;vertical-alignment:center;}
            clicked=>{Shell.cloud-open(self.absolute-position.x,self.absolute-position.y+self.height+10px,false);}
        }
        Chevron {
            x: Shell.native-shell-view ? 16px : Shell.cloud.label != "" ? cloud.width - 11px : 16px + 9px;
            width: Shell.native-shell-view ? 19px : 26px;
            glyph-trim: Shell.native-shell-view ? 1px : 0px;
            y: 4px;
            index: -1;
            context(x, y) => {
                root.kb-at = -1;
                root-focus.focus();
            }
        }

        // It starts 3px before the crumbs: the overflow button's plate and the focus ring
        // reach there.
        trail := Rectangle {
            x: Shell.native-shell-view ? 37px : (Shell.cloud.label != "" ? cloud.width - 12px : 16px + 9px) + 26px - 2px;
            width: parent.width - self.x;
            clip: true;
            changed width => { Shell.trail-width(self.width - 3px); }
            init => { Shell.trail-width(self.width - 3px); }

            HorizontalLayout {
                x: Shell.native-shell-view ? 0px : 3px;
                width: parent.width - (Shell.native-shell-view ? 0px : 3px);
                y: 4px;
                height: 24px;
                alignment: start;
                if Shell.hidden-crumbs > 0: more := CrumbButton {
                    width: 30px;
                    plain: true;
                    // Its plate reaches a pixel further left than its slot.
                    Rectangle {
                        x: -1px;
                        width: 31px;
                        border-radius: 4px;
                        background: more.pressed ? Theme.subtle-pressed : more.hovered ? Theme.subtle-hover : transparent;
                    }
                    Glyph {
                        x: 0;
                        y: -1px;
                        width: 30px;
                        height: parent.height;
                        text: Glyphs.more;
                        font-size: Shell.native-shell-view ? 12px : 14px;
                    }
                    // Its dropdown is centred under it.
                    clicked => {
                        Shell.crumb-menu(-2, self.absolute-position.x + self.width / 2 - 0.5px, self.absolute-position.y + self.height + 3px);
                    }
                    if root.kb && root.kb-at == -2: FocusRing {
                        width: 32px;
                    }
                }
                for crumb[i] in Shell.crumbs: CrumbItem {
                    visible: i >= Shell.hidden-crumbs;
                    width: i >= Shell.hidden-crumbs ? self.measured : 0px;
                    crumb: crumb;
                    index: i;
                    ring: root.kb && root.kb-at == i;
                }
            }
        }
    }

    to-end := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            input.set-selection-offsets(0, 1000000);
        }
    }

    // The text scrolls to keep the caret in view (a TextInput doesn't on its own).
    property <length> scroll-x;
    field := Rectangle {
        visible: root.editing;
        x: 11px;
        width: parent.width - 11px - (root.editing && input.text != "" ? 40px : 11px);
        height: parent.height;
        clip: true;

        input := TextInput {
            x: min(0px, max(parent.width - self.width, root.scroll-x));
            // Room for the caret past the end, as Explorer leaves.
            width: max(parent.width, self.preferred-width + 2px);
            height: parent.height;
            font-family: Shell.native-shell-view ? "Segoe UI" : "Segoe UI Variable Small";
            font-size: Shell.native-shell-view ? 12px : 14px;
            color: Theme.text;
            vertical-alignment: center;
            single-line: true;
            selection-background-color: #0078d4;
            selection-foreground-color: #ffffff;
            key-pressed(e) => {
                if e.text == Key.DownArrow { root.pick(1); return accept; }
                if e.text == Key.UpArrow { root.pick(-1); return accept; }
                if e.text == Key.Escape { root.cancel(); return accept; }
                reject
            }
            edited => {
                root.typed = self.text;
                Shell.address-edited(self.text);
            }
            cursor-position-changed(pos) => {
                if pos.x + root.scroll-x < 0px {
                    root.scroll-x = -pos.x;
                } else if pos.x + root.scroll-x > field.width - 3px {
                    root.scroll-x = field.width - 3px - pos.x;
                }
            }
            // The crumbs come back first: an error box shows over them.
            accepted => {
                root.editing = false;
                Shell.address-commit(self.text);
            }
            // A menu of ours taking the focus (the text menu) doesn't end editing.
            changed has-focus => {
                if !self.has-focus && !Shell.menu-open { root.editing = false; }
                if self.has-focus { Shell.focus-noted("address"); }
            }
        }
    }

    // Clears the text (a 30 x 22 plate, 5px in from the right).
    if root.editing && input.has-focus && input.text != "": Rectangle {
        x: parent.width - 5px - 30px;
        y: 5px;
        width: 30px;
        height: 22px;
        border-radius: 4px;
        // The light theme shows the plate only under the pointer.
        background: clear.pressed ? Theme.subtle-pressed : clear.has-hover || Theme.dark ? Theme.subtle-hover : transparent;
        Glyph {
            text: Glyphs.clear;
            font-size: 12px;
            color: Theme.text-secondary;
        }
        clear := TouchArea {
            clicked => {
                input.text = "";
                root.typed = "";
                Shell.address-edited("");
                input.focus();
            }
        }
    }

    // Inside the border's rounded corners.
    if root.editing: Rectangle {
        x: 1px;
        y: parent.height - 2px;
        width: parent.width - 2px;
        height: 2px;
        border-bottom-left-radius: 3px;
        border-bottom-right-radius: 3px;
        background: Theme.accent;
    }

    // The suggestions hang from the box, their dark hairline over the underline's last row;
    // 40px rows, scrolling past 374px.
    Rectangle {
        visible: root.listing;
        y: parent.height - 1px;
        width: parent.width;
        height: min(Shell.suggestions.length * 40px, 374px) + 6px;
        // Catches the pointer between rows.
        TouchArea { }

        // Inside the hairline, which lies over what is behind.
        Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            border-bottom-left-radius: 7px;
            border-bottom-right-radius: 7px;
            background: Theme.suggestions;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: Theme.flyout-shadow;
        }

        rows := Flickable {
            x: 1px;
            y: 3px;
            width: parent.width - 2px;
            height: parent.height - 6px;
            content-height: Shell.suggestions.length * 40px;
            for s[i] in Shell.suggestions: SuggestionRow {
                y: i * 40px;
                width: parent.width;
                text: s;
                picked: Shell.suggest-index == i;
                clicked => {
                    Shell.suggestion-chosen(i);
                    root.editing = false;
                }
            }
        }

        Rectangle {
            border-bottom-left-radius: 8px;
            border-bottom-right-radius: 8px;
            border-width: 1px;
            border-color: Theme.suggestions-border;
        }
    }
}

component SearchBox inherits Rectangle {
    opacity: Shell.settings-view ? 0.4 : 1;
    width: 248px;
    height: Shell.native-shell-view ? 34px : 32px;
    border-radius: Shell.native-shell-view ? 0px : 4px;
    background: Shell.native-shell-view ? (Theme.dark ? #191919 : #ffffff) : input.has-focus ? Theme.search-focus : touch.has-hover ? Theme.control-hover : Theme.control;
    border-width: Shell.native-shell-view || input.has-focus ? 1px : 0px;
    border-color: Shell.native-shell-view ? (Theme.dark ? #535353 : #b0b0b0) : Theme.search-focus-border;

    // The field sits inside the hover area, so the box lights over the text too.
    touch := TouchArea {
        enabled: !Shell.settings-view;
        mouse-cursor: text;
        clicked => { input.focus(); }

        Text {
            x: 15px;
            y: -1px;
            width: parent.width - 15px - 44px;
            height: parent.height;
            visible: input.text == "";
            text: Shell.native-shell-view ? Shell.native-search-scope : @tr("nav.search", Shell.location-name);
            font-family: Shell.native-shell-view ? "Segoe UI" : Theme.font-text;
            font-size: Shell.native-shell-view ? 12px : 14px;
            color: Shell.native-shell-view ? (Theme.dark ? #777777 : #707070) : Theme.text-secondary;
            vertical-alignment: center;
            overflow: clip;
        }

        // Typed text sits 4px left of the placeholder, in XAML's text box face (opsz 8).
        input := TextInput {
            enabled: !Shell.settings-view;
            x: 11px;
            width: parent.width - 11px - 44px;
            height: parent.height;
            text <=> Shell.search-text;
            font-family: Shell.native-shell-view ? "Segoe UI" : "Segoe UI Variable Small";
            font-size: Shell.native-shell-view ? 12px : 14px;
            color: Theme.text;
            vertical-alignment: center;
            single-line: true;
            selection-background-color: #0078d4;
            selection-foreground-color: #ffffff;
            edited => { Shell.search-edited(self.text); }
            changed has-focus => { if self.has-focus { Shell.focus-noted("search"); } }
        }
    }

    Glyph {
        x: parent.width - 13px - 12px;
        width: 12px;
        text: Glyphs.search;
        font-size: 12px;
    }

    if input.has-focus: Rectangle {
        y: parent.height - 2px;
        height: 2px;
        border-bottom-left-radius: 4px;
        border-bottom-right-radius: 4px;
        background: Theme.accent;
    }

    public function focus-search() {
        if Shell.settings-view { return; }
        input.focus();
        input.select-all();
    }
    public function type-search(text: string) {
        Shell.search-text = text;
        input.focus();
        input.set-selection-offsets(1000000,1000000);
        Shell.search-edited(text);
    }
}

export component NavigationBar inherits Rectangle {
    height: 48px;
    background: Shell.native-shell-view ? (Theme.dark ? #191919 : #ffffff) : Theme.layer;

    public function edit-address() { address.edit(); }
    public function focus-search() { search.focus-search(); }
    public function type-search(text: string) { search.type-search(text); }
    public function focus-crumb() { address.focus-crumb(); }
    public function focus-button(id: string) { Shell.nav-focus = id; Shell.nav-focus-request += 1; }

    NavButton {
        focus-id: "back";
        x: Shell.native-shell-view ? 4px : 11px;
        y: Shell.native-shell-view ? 9px : 8px;
        glyph: Glyphs.back;
        tip: @tr("nav.back.tip", Shell.back-name);
        enabled: Shell.can-back;
        clicked => { Shell.back(); }
        context(x, y) => { Shell.history-menu(true, x, y); }
    }
    NavButton {
        focus-id: "forward";
        x: Shell.native-shell-view ? 39px : 59px;
        y: Shell.native-shell-view ? 9px : 8px;
        glyph: Glyphs.forward;
        tip: @tr("nav.forward.tip", Shell.forward-name);
        enabled: Shell.can-forward;
        clicked => { Shell.forward(); }
        context(x, y) => { Shell.history-menu(false, x, y); }
    }
    NavButton {
        focus-id: "up";
        x: Shell.native-shell-view ? 99px : 107px;
        y: Shell.native-shell-view ? 9px : 8px;
        glyph: Glyphs.up;
        tip: Shell.parent-name != "" ? @tr("nav.up-to.tip", Shell.parent-name) : @tr("nav.up.tip");
        enabled: Shell.can-up;
        clicked => { Shell.up(); }
    }
    NavButton {
        visible:!Shell.native-shell-view;
        focus-id: "refresh";
        x: Shell.native-shell-view ? root.width - 262px : 155px;
        y: Shell.native-shell-view ? 9px : 8px;
        glyph: Glyphs.refresh;
        tip: @tr("nav.refresh.tip", Shell.location-name);
        clicked => { Shell.refresh(); }
    }

    // The address and search boxes share the row 7:3, past a fixed 37⅓px the address keeps
    // (as measured from 600 to 1900px wide windows), 8px apart and 11px from the edge.
    property <length> boxes: root.width - (Shell.native-shell-view ? 137px : 201px) - (Shell.native-shell-view ? 12px : 8px) - (Shell.native-shell-view ? 12px : 11px);
    property <length> search-width: Shell.native-shell-view ? 202px : round((root.boxes - 37.333px) * 0.3 / 1px) * 1px;

    address := Address {
        x: Shell.native-shell-view ? 137px : 201px;
        y: Shell.native-shell-view ? 9px : 8px;
        width: root.boxes - root.search-width;
        tab-out => { search.focus-search(); }
    }

    search := SearchBox {
        x: (Shell.native-shell-view ? 137px : 201px) + address.width + (Shell.native-shell-view ? 12px : 8px);
        y: Shell.native-shell-view ? 9px : 8px;
        width: max(50px,root.search-width - 40px);

    }
    NavButton {
        x:root.width - 43px;y:Shell.native-shell-view?9px:8px;
        focus-id:"settings";glyph:Glyphs.settings;tip:@tr("settings.title");
        clicked=>{Shell.settings-open();}
    }
    if Shell.native-shell-view: NavButton {
        x:74px;y:9px;width:24px;focus-id:"history";glyph:Glyphs.chevron-down;
        clicked=>{Shell.history-menu(true,self.absolute-position.x,self.absolute-position.y+self.height);}
    }
    if Shell.native-shell-view: NavButton {
        x:address.x + address.width - 65px;y:9px;width:30px;focus-id:"address-drop";glyph:Glyphs.chevron-down;
        clicked=>{address.edit();}
    }
    if Shell.native-shell-view: NavButton {
        x:address.x + address.width - 35px;y:9px;
        focus-id:"refresh";glyph:Glyphs.refresh;tip:@tr("nav.refresh.tip",Shell.location-name);
        clicked=>{Shell.refresh();}
    }
}
