// Icon views. Stacked (extra large, large, medium icons): thumbnail over a centred name that
// wraps to two lines. Inline (small icons, list): icon and name on one line. Tiles: 48px icon
// beside name, type and size. Rust lays the cells out (Entry.cell-*) from the label line
// counts reported here.
import { Theme } from "theme.slint";
import { Shell, Entry } from "shell.slint";
import { ScrollBar } from "scrollbar.slint";
import { ItemTip, Tip } from "tooltip.slint";
import { GroupHeader, EmptyLibraryHeader } from "group-header.slint";
import { CheckBox } from "check-box.slint";
import { Underlines } from "underline.slint";

// "Tipo: Arquivo ZIP": a muted label and its value, on one line.
component ContentField inherits HorizontalLayout {
    in property <bool> underline;
    in property <string> label;
    in property <string> value;
    spacing: 4px;
    alignment: start;
    if root.label != "": Text {
        text: root.label + ":";
        font-family: Theme.font-dui;
        font-size: 12px;
        color: Theme.header-text;
        if root.underline: Underlines { width: parent.width; text: parent.text; ink: parent.color; }
    }
    Text {
        horizontal-stretch: 1;
        text: root.value;
        font-family: Theme.font-dui;
        font-size: 12px;
        color: Theme.dui-text;
        overflow: elide;
        if root.underline: Underlines { width: parent.width; text: parent.text; ink: parent.color; }
    }
}

component Cell inherits Rectangle {
    in property <Entry> entry;
    in property <int> index;
    in property <bool> list-focus;
    in property <length> icon-size;
    in property <int> kind; // 0 stacked, 1 inline, 2 tile
    callback focus-list();
    property <bool> focused: Shell.focused-row == root.index;
    property <color> name-ink: root.entry.name-style == 1 ? Theme.compressed-text : root.entry.name-style == 2 ? Theme.encrypted-text : Theme.dui-text;
    property <bool> underline: Shell.single-click && (!Shell.underline-hover-only || touch.has-hover);
    // All views exist at once (hidden ones too); only the shown one edits, or the hidden
    // editor would take the focus.
    property <bool> renaming: Shell.renaming-row == root.index && Shell.icons-view && !Shell.drives-view;
    property <bool> dragging;

    x: root.entry.cell-x;
    y: root.entry.cell-y;
    width: root.entry.cell-w;
    height: root.entry.cell-h;
    // The focused cell of a multiple selection looks singly selected.
    property <bool> multi: root.list-focus && root.entry.selected && Shell.multi-selected && !root.focused;
    background: root.entry.selected
        ? (root.multi ? Theme.row-multi : !root.list-focus ? Theme.nav-selected : touch.has-hover && !Shell.single-click ? Theme.row-selected-hover : Theme.row-selected)
        : (touch.has-hover || Shell.drop-row == root.index) ? Theme.row-hover : transparent;
    // The light theme also edges a selection without the focus.
    border-width: root.multi || (root.list-focus && root.focused) || (!root.list-focus && root.entry.selected) ? 1px : 0px;
    border-color: root.multi ? Theme.row-multi-border : !root.list-focus ? Theme.nav-selected-border : Theme.focus-rect;

    touch := TouchArea {
        mouse-cursor: Shell.single-click ? pointer : default;
        changed has-hover => { Shell.row-hover(root.index,self.has-hover,self.absolute-position.x+self.mouse-x,self.absolute-position.y+self.mouse-y); }
        changed mouse-x => { if self.has-hover && !self.pressed { Shell.row-hover(root.index,true,self.absolute-position.x+self.mouse-x,self.absolute-position.y+self.mouse-y); } }
        changed mouse-y => { if self.has-hover && !self.pressed { Shell.row-hover(root.index,true,self.absolute-position.x+self.mouse-x,self.absolute-position.y+self.mouse-y); } }
        moved => {
            if self.pressed && !root.dragging && root.entry.selected
                && (abs(self.mouse-x - self.pressed-x) > 4px || abs(self.mouse-y - self.pressed-y) > 4px) {
                root.dragging = true;
                Shell.drag-start();
            }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down { root.focus-list(); root.dragging = false; }
            if e.kind == PointerEventKind.up && root.dragging { root.dragging = false; return; }
            Shell.row-pointer(root.index, e);
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
                Shell.list-context(root.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, e.modifiers.shift);
            }
        }
        double-clicked => { Shell.row-double-clicked(root.index); }
    }

    // The keyboard's tip: under the cell, 4px in (stacked cells: 2px over its bottom).
    property <bool> key-tip: Shell.key-tip-row == root.index;
    changed key-tip => {
        if self.key-tip && root.entry.tip != "" {
            Tip.text = root.entry.tip;
            Tip.x = root.absolute-position.x + 4px;
            Tip.y = root.absolute-position.y + root.height - (root.kind == 0 ? 2px : 0px);
            Tip.classic = true;
            Tip.pending = false;
            Tip.shown = true;
        }
    }

    // The keyboard's menu opens at the icon's middle, a pixel right (as measured in details).
    property <bool> key-menu: Shell.key-menu-row == root.index && Shell.icons-view && !Shell.drives-view;
    property <length> icon-x: root.kind == 0 ? floor((root.width - root.icon-size) / 2px) * 1px : root.kind == 1 ? 32px : 4px;
    property <length> icon-y: root.kind == 2 ? (root.height - 48px) / 2 : 2px;
    property <length> icon-side: root.kind == 2 ? 48px : root.icon-size;
    changed key-menu => {
        if self.key-menu {
            Shell.key-menu-row = -1;
            Shell.key-menu(root.index, root.absolute-position.x + root.icon-x + root.icon-side / 2 + 1px, root.absolute-position.y + root.icon-y + root.icon-side / 2);
        }
    }

    ItemTip {
        hover: touch.has-hover;
        pressed: touch.pressed;
        tip: root.entry.tip;
        pointer-x: touch.absolute-position.x + touch.mouse-x;
        pointer-y: touch.absolute-position.y + touch.mouse-y;
        request => { Shell.item-hovered(root.index); }
    }

    if Shell.check-boxes && (touch.has-hover || root.entry.selected): CheckBox {
        x: 4px;
        y: 2px;
        checked: root.entry.selected;
        toggled => {
            root.focus-list();
            Shell.row-check(root.index);
        }
    }

    if root.kind == 0: Image {
        x: floor((parent.width - root.icon-size) / 2px) * 1px;
        y: 2px;
        width: root.icon-size;
        height: root.icon-size;
        source: root.entry.big-icon;
        image-fit: contain;
        opacity: root.entry.ghost ? 0.5 : 1;
    }

    // Small icons and list: the icon 32px in (Explorer keeps that room), the name 2px after
    // it. Small icons grow up to 31px.
    if root.kind == 1: Image {
        x: 32px;
        y: 2px;
        width: root.icon-size;
        height: root.icon-size;
        source: root.icon-size > 16px ? root.entry.big-icon : root.entry.icon;
        image-fit: contain;
        opacity: root.entry.ghost ? 0.5 : 1;
    }
    // Centred 1px above the row's middle.
    if root.kind == 1 && !root.renaming: Text {
        x: root.icon-size + 34px;
        y: 0;
        width: parent.width - self.x - 6px;
        height: parent.height - 2px;
        text: root.entry.name;
        font-family: Theme.font-dui;
        font-size: 12px;
        color: root.name-ink;
        vertical-alignment: center;
        overflow: elide;
        if root.underline: Underlines { width: parent.width; text: parent.text; ink: parent.color; baseline: floor((parent.height - 15px) / 2px) * 1px + 14px; }
    }

    // Tiles: 48px icon, then name, type and size (a folder's name sits as the first of two
    // lines).
    if root.kind == 2: Image {
        x: 4px;
        y: (parent.height - 48px) / 2;
        width: 48px;
        height: 48px;
        source: root.entry.big-icon;
        image-fit: contain;
        opacity: root.entry.ghost ? 0.5 : 1;
    }
    // The name takes up to two lines, then the file type's tile properties, three lines in
    // all. The lines are centred as a block (a folder's name over its one empty property).
    property <int> tile-name-lines: root.kind == 2 ? min(2, max(1, round(tile-measure.preferred-height / 16px))) : 1;
    property <int> tile-props: root.entry.folder ? max(0,2 - root.tile-name-lines) : root.entry.fields.length > 0 ? min(root.entry.fields.length, 3 - root.tile-name-lines)
        : 3 - root.tile-name-lines;
    property <int> tile-lines: root.tile-name-lines + root.tile-props;
    // Measured: three lines start 1px down, two 8px.
    property <length> tile-top: root.tile-lines >= 3 ? 1px : 8px;
    tile-measure := Text {
        visible: false;
        width: root.width - 57px - 4px;
        text: root.kind == 2 ? root.entry.name : "";
        font-family: Theme.font-dui;
        font-size: 12px;
        wrap: word-wrap;
    }
    if root.kind == 2 && !root.renaming: Text {
        x: 57px;
        y: root.tile-top + (root.tile-name-lines > 1 ? 2px : 0px);
        width: parent.width - 57px - 4px;
        height: root.tile-name-lines * 16px;
        text: Shell.tile-label(root.entry.name,self.width);
        font-family: Theme.font-dui;
        font-size: 12px;
        color: root.name-ink;
        wrap: no-wrap;
        line-height-factor: root.tile-name-lines > 1 ? 0.94 : 1.0;
        max-lines: 2;
        overflow: elide;
        if root.underline: Underlines { width: parent.width; text: parent.text; ink: parent.color; baseline: root.tile-name-lines > 1 ? 13px : 14px; pitch: 15px; }
    }
    for field[k] in root.kind == 2 ? root.entry.fields : []: Text {
        x: 57px;
        y: root.tile-top + (root.tile-name-lines + k) * 16px;
        width: root.width - 57px - 4px;
        visible: k < root.tile-props;
        text: field.value;
        font-family: Theme.font-dui;
        font-size: 12px;
        color: Shell.single-click && root.entry.selected ? Theme.dui-text : Theme.header-text;
        overflow: elide;
        if root.underline: Underlines { width: parent.width; text: parent.text; ink: parent.color; }
    }

    // Content: a 48px row over a separator line: 32px icon, the name in 15px over the first
    // property, then two columns of two (the file type's content properties). Measured on
    // the real's rows from 453 to 1253px of line: the middle column sits at a fixed x; the
    // right one at 3/5 of the line, at most 288px from its end, and no further than 673.
    // A property with a label shows only when it fits its column whole; one without (a
    // path) is elided, given 80px.
    property <length> content-line: root.width - 13px;
    property <length> content-right: 4px + min(max(root.content-line * 0.6 + 34.4px, root.content-line - 288px), 669px);
    property <length> content-middle: 373px;
    property <length> content-end: 4px + root.content-line;
    pure function field-x(k: int) -> length {
        return k == 0 ? 73px : k <= 2 ? root.content-middle : root.content-right;
    }
    // The room a column's field (1-2 the middle column, 3-4 the right one) has before the
    // next column, 8px apart; the field under the name (0) reaches the first column shown.
    pure function column-room(k: int) -> length {
        return (k <= 2 ? root.content-right : root.content-end) - root.field-x(k) - 8px;
    }
    pure function fits-in(k: int, room: length) -> bool {
        return k < root.entry.fields.length && k < 5 && root.entry.fields[k].shown
            && (root.entry.fields[k].label == "" ? room >= 80px : root.entry.fields[k].width <= room);
    }
    property <bool> middle-shown: root.fits-in(1, root.column-room(1)) || root.fits-in(2, root.column-room(2));
    property <length> name-room: (root.fits-in(1,root.column-room(1)) ? root.content-middle
        : root.fits-in(3,root.column-room(3)) ? root.content-right : root.content-end) - 73px - 8px;
    property <length> under-name-room: (root.fits-in(2,root.column-room(2)) ? root.content-middle
        : root.fits-in(4,root.column-room(4)) ? root.content-right : root.content-end) - 73px - 8px;
    pure function room(k: int) -> length {
        return k == 0 ? root.under-name-room : root.column-room(k);
    }
    pure function fits(k: int) -> bool {
        return root.fits-in(k, root.room(k));
    }
    if root.kind == 3: Rectangle {
        x: 4px;
        y: 48px;
        width: parent.width - 13px;
        height: 1px;
        background: Theme.content-line;
    }
    if root.kind == 3: Image {
        x: 34px;
        y: 8px;
        width: 32px;
        height: 32px;
        source: root.entry.big-icon;
        image-fit: contain;
        opacity: root.entry.ghost ? 0.5 : 1;
    }
    // A search's match in the name: a box 2px before it to 1px past it, as tall as the
    // name's line.
    if root.kind == 3 && !root.renaming && root.entry.hit.width > 0 && root.entry.hit.x < root.name-room: Rectangle {
        x: 73px + root.entry.hit.x - 2px;
        y: 5px;
        width: min(root.entry.hit.width + 4px, root.name-room - root.entry.hit.x + 2px);
        height: 21px;
        border-radius: 3px;
        border-width: 1px;
        border-color: Theme.hit-border;
        background: Theme.hit;
    }
    if root.kind == 3 && !root.renaming: Text {
        x: 73px;
        y: 5px;
        width: root.name-room;
        text: root.entry.name;
        font-family: Theme.font-dui;
        font-size: 15px;
        color: root.name-ink;
        overflow: elide;
        if root.underline: Underlines { width: parent.width; text: parent.text; ink: parent.color; font-size: 15px; baseline: 17px; }
    }
    for field[k] in root.kind == 3 ? root.entry.fields : []: ContentField {
        underline: root.underline;
        x: root.field-x(k);
        y: k == 1 || k == 3 ? 9px : 26px;
        width: root.room(k);
        visible: root.fits(k);
        label: field.label;
        value: field.value;
    }

    if root.kind == 0: label := Text {
        x: 6px;
        y: root.icon-size + 2px;
        width: parent.width - 12px;
        visible: !root.renaming;
        text: root.entry.stacked-collapsed;
        font-family: Theme.font-dui;
        font-size: 12px;
        line-height-factor: 0.94;
        color: root.name-ink;
        horizontal-alignment: center;
        wrap: no-wrap;
        if root.underline: Underlines { width: parent.width; text: parent.text; ink: parent.color; align: 1; baseline: 13px; pitch: 15px; }
        // The real keeps its four-line cap after selecting/hovering a long dummy name.
        // Explicit lines and the fourth-line ellipsis come from DrawTextEx.
    }

    if root.renaming: Rectangle {
        x: root.kind == 0 ? 2px : root.kind == 1 ? 48px : root.kind == 2 ? 54px : 70px;
        y: root.kind == 0 ? 2px + root.icon-size : root.kind == 3 ? 4px : (parent.height - 18px) / 2;
        width: root.kind == 0 ? parent.width - 4px : parent.width - self.x - 4px;
        height: 18px;
        background: Theme.edit-box;
        border-width: 1px;
        border-color: Theme.edit-border;
        clip: true;
        TextInput {
            x: 3px;
            width: parent.width - 6px;
            text: Shell.rename-seed;
            font-family: Theme.font-dui;
            font-size: 12px;
            color: Theme.dui-text;
            horizontal-alignment: center;
            vertical-alignment: center;
            single-line: true;
            selection-background-color: #0078d4;
            selection-foreground-color: #ffffff;
            property <bool> done;
            init => {
                self.focus();
                self.set-selection-offsets(0, Shell.rename-select-end);
            }
            accepted => {
                if !self.done {
                    self.done = true;
                    Shell.rename-finished(true, self.text);
                }
            }
            key-pressed(e) => {
                if e.text == Key.Escape {
                    self.done = true;
                    Shell.rename-finished(false, self.text);
                    return accept;
                }
                reject
            }
            changed has-focus => {
                if !self.has-focus && !self.done {
                    self.done = true;
                    Shell.rename-finished(true, self.text);
                }
            }
        }
    }
}

export component IconsView inherits Rectangle {
    background: Theme.content;
    forward-focus: scope;

    property <length> band-x0;
    property <length> band-y0;
    property <length> band-x1;
    property <length> band-y1;
    property <bool> banding;
    property <bool> band-moved;
    property <length> band-mouse-y;

    public function focus-list() { scope.focus(); }

    // The keyboard's menu for the folder opens at the view's corner.
    property <bool> key-menu: Shell.key-menu-row == -2 && Shell.icons-view && !Shell.drives-view;
    changed key-menu => {
        if self.key-menu {
            Shell.key-menu-row = -1;
            Shell.key-menu(-1, root.absolute-position.x, root.absolute-position.y);
        }
    }

    changed width => { Shell.grid-viewport(self.width, self.height); }
    changed height => { Shell.grid-viewport(self.width, self.height); }
    init => { Shell.grid-viewport(self.width, self.height); }

    scope := FocusScope {
        changed has-focus => { Shell.list-focused = self.has-focus; if self.has-focus { Shell.focus-noted("list"); } }
        key-pressed(e) => {
            // A key puts an item's tip away.
            Tip.pending = false;
            Tip.shown = false;
            if Shell.list-key(e) { return accept; }
            reject
        }

        band-area := TouchArea {
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    scope.focus();
                    Shell.background-pointer(e);
                    if e.button == PointerEventButton.left {
                        root.banding = true;
                        root.band-moved = false;
                        root.band-x0 = self.mouse-x - flick.content-x;
                        root.band-y0 = self.mouse-y - flick.content-y;
                        root.band-x1 = root.band-x0;
                        root.band-y1 = root.band-y0;
                    }
                }
                if e.kind == PointerEventKind.up {
                    if e.button == PointerEventButton.left { root.banding = false; }
                    if e.button == PointerEventButton.right {
                        Shell.list-context(-1, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, e.modifiers.shift);
                    }
                }
            }
            moved => {
                if root.banding {
                    root.band-mouse-y = self.mouse-y;
                    root.band-x1 = self.mouse-x - flick.content-x;
                    root.band-y1 = self.mouse-y - flick.content-y;
                    if abs(root.band-x1 - root.band-x0) >= 4px || abs(root.band-y1 - root.band-y0) >= 4px {
                        root.band-moved = true;
                    }
                    if root.band-moved {
                        Shell.band-changed(min(root.band-x0, root.band-x1), min(root.band-y0, root.band-y1),
                            abs(root.band-x1 - root.band-x0), abs(root.band-y1 - root.band-y0), self.pressed, true);
                    }
                }
            }
        }

        // A band held at (or past) the top or bottom edge scrolls the view, as in the
        // details list.
        property <bool> band-down: root.band-mouse-y >= flick.height - 1px;
        property <bool> band-up: root.band-mouse-y <= 0px;
        Timer {
            interval: 47ms;
            running: root.banding && root.band-moved && !Shell.grid-list && (band-down || band-up);
            triggered => {
                if band-down {
                    Shell.list-nudge(max(4px, root.band-mouse-y - flick.height + 3px));
                } else {
                    Shell.list-nudge(-max(4px, 3px - root.band-mouse-y));
                }
                root.band-y1 = root.band-mouse-y - flick.content-y;
                Shell.band-changed(min(root.band-x0, root.band-x1), min(root.band-y0, root.band-y1),
                    abs(root.band-x1 - root.band-x0), abs(root.band-y1 - root.band-y0), band-area.pressed, true);
            }
        }

        flick := Flickable {
            for group in Shell.empty-library-groups: EmptyLibraryHeader {
                x: group.x;
                y: group.y;
                width: group.width < 0px ? flick.width : group.width;
                label: group.label;
                folded: group.folded;
                chevron: !Shell.grid-list;
            }
            // Rust scrolls it (wheel, bars, keys); the empty space's clicks reach the band.
            interactive: false;
            content-height: max(self.height, Shell.grid-height);
            // The wheel can take the List view's last column to the left edge, past the end.
            content-width: max(self.width, Shell.grid-width, self.width - Shell.grid-scroll-x);
            content-x <=> Shell.grid-scroll-x;
            content-y <=> Shell.list-scroll-y;
            // Scrolling puts an item's tip away.
            changed content-y => { Tip.pending = false; Tip.shown = false; }
            changed content-x => { Shell.grid-scrolled(); }

            for i in Shell.icons-view && !Shell.drives-view ? Shell.grid-heads : []: GroupHeader {
                property <Entry> entry: Shell.entries[i];
                x: self.entry.header-x;
                y: self.entry.header-y;
                label: self.entry.header;
                collapsed: self.entry.collapsed;
                index: i;
                list-focus: scope.has-focus;
                // The list sizes each header to its group; the other views span the width.
                chevron: self.entry.header-w < 0px;
                plate-width: self.entry.header-w >= 0px ? self.entry.header-w : flick.width - 18px;
                focus-list => { scope.focus(); }
            }
            for i in Shell.icons-view && !Shell.drives-view ? Shell.grid-slots : []: Cell {
                entry: Shell.entries[i];
                index: i;
                icon-size: Shell.icon-size;
                kind: Shell.grid-kind;
                list-focus: scope.has-focus;
                focus-list => { scope.focus(); }
            }
        }

        // The names to measure, as the cells lay them out.
        for m in Shell.grid-measure: Text {
            visible: false;
            width: Shell.grid-measure-wrap ? Shell.grid-label-width : 10000px;
            text: m.name;
            font-family: Theme.font-dui;
            font-size: 12px;
            line-height-factor: Shell.grid-measure-wrap ? 0.94 : 1;
            wrap: Shell.grid-measure-wrap ? word-wrap : no-wrap;
            max-lines: Shell.grid-measure-wrap ? 4 : 0;
            overflow: elide;
            init => { Shell.name-measured(m.name, self.preferred-width, max(1, round(self.preferred-height / 15px))); }
        }

        // The band, cut to the view.
        if root.banding && root.band-moved: Rectangle {
            x: flick.x;
            y: flick.y;
            width: flick.width;
            height: flick.height;
            clip: true;
            Rectangle {
                x: min(root.band-x0, root.band-x1) + flick.content-x;
                y: min(root.band-y0, root.band-y1) + flick.content-y;
                width: abs(root.band-x1 - root.band-x0);
                height: abs(root.band-y1 - root.band-y0);
                border-width: 1px;
                border-color: Theme.band-border;
                background: Theme.band;
            }
        }

        // "Esta pasta está vazia.": in the items' colour, its ink 18px down as in the details
        // view under its header.
        if Shell.entries.length == 0 && Shell.empty-library-groups.length == 0: Text {
            y: 14px;
            width: parent.width;
            text: Shell.error-text != "" ? Shell.error-text : Shell.empty-text;
            font-family: Theme.font-dui;
            font-size: 12px;
            color: Theme.dui-text;
            horizontal-alignment: center;
        }

        // Explorer's items view bars: 17px.
        // Its arrows and track step by rows and pages, as the wheel does.
        ScrollBar {
            dui: true;
            stepped: true;
            x: parent.width - self.width;
            y: 0;
            width: 17px;
            value <=> flick.content-y;
            content: flick.content-height;
            page: flick.height;
            scrolled => { Shell.list-scrolled(); }
            lines(n) => { Shell.list-lines(n); }
            pages(n) => { Shell.list-pages(n); }
        }
        ScrollBar {
            dui: true;
            horizontal: true;
            x: 0;
            y: parent.height - self.height;
            height: 17px;
            value <=> Shell.grid-column-value;
            content: Shell.grid-column-count * 48px;
            page: 48px;
            scrolled => { Shell.grid-column-scrolled(); }
        }
    }
}
