import { Theme } from "theme.slint";
import { Shell } from "shell.slint";
import { Tip } from "tooltip.slint";
component DateCaret inherits Rectangle {
 in property <bool> down;
 width:8px;height:6px;
 for pixel in [
  {x:2,y:0,a:0.339},{x:3,y:0,a:0.926},{x:4,y:0,a:0.926},{x:5,y:0,a:0.339},
  {x:2,y:1,a:0.891},{x:3,y:1,a:1},{x:4,y:1,a:1},{x:5,y:1,a:0.891},
  {x:1,y:2,a:0.696},{x:2,y:2,a:1},{x:3,y:2,a:1},{x:4,y:2,a:1},{x:5,y:2,a:1},{x:6,y:2,a:0.696},
  {x:0,y:3,a:0.339},{x:1,y:3,a:1},{x:2,y:3,a:1},{x:3,y:3,a:1},{x:4,y:3,a:1},{x:5,y:3,a:1},{x:6,y:3,a:1},{x:7,y:3,a:0.339},
  {x:0,y:4,a:0.891},{x:1,y:4,a:1},{x:2,y:4,a:1},{x:3,y:4,a:1},{x:4,y:4,a:1},{x:5,y:4,a:1},{x:6,y:4,a:1},{x:7,y:4,a:0.891},
  {x:0,y:5,a:0.891},{x:1,y:5,a:1},{x:2,y:5,a:1},{x:3,y:5,a:1},{x:4,y:5,a:1},{x:5,y:5,a:1},{x:6,y:5,a:1},{x:7,y:5,a:0.891}
 ]:Rectangle{x:pixel.x*1px;y:(root.down ? 5-pixel.y : pixel.y)*1px;width:1px;height:1px;background:Theme.text;opacity:pixel.a;}
}
export component GalleryView inherits Rectangle {
 property <bool> dragging-date;
 property <length> date-grab-offset;
 background: Theme.content;
 callback focus-list();
 focus-list => {scope.focus();}
 changed width => {Shell.gallery-viewport(self.width,self.height);}
 changed height => {Shell.gallery-viewport(self.width,self.height);}
 init => {Shell.gallery-viewport(self.width,self.height);}
 scope := FocusScope {
  changed has-focus => {if self.has-focus {Shell.focus-noted("list");}}
  width:parent.width;height:parent.height;
  key-pressed(e) => {if Shell.list-key(e){return accept;} reject}
  TouchArea {
   width:parent.width;height:parent.height;
   pointer-event(e) => {if e.kind==PointerEventKind.down {scope.focus();} Shell.background-pointer(e);}
  }
  Text {
   x:32px;y:14px;width:parent.width - 120px;height:29px;
   text:Shell.gallery-heading;font-family:Theme.font-small;font-size:14px;font-weight:600;color:Theme.text;
   vertical-alignment:center;overflow:elide;
  }
  Rectangle {
   y:61px;width:parent.width;height:parent.height - 61px;clip:true;
   for tile in Shell.gallery-view ? Shell.gallery-tiles : []: Rectangle {
    x:tile.x;y:tile.y;width:tile.width;height:tile.height;
    border-radius:4px;clip:true;background:Theme.dark ? #202020 : #f5f5f5;
    Image {width:parent.width;height:parent.height;source:tile.picture;image-fit:cover;}
    if tile.selected || touch.has-hover: Rectangle {
     width:parent.width;height:parent.height;border-radius:4px;border-width:tile.selected ? 3px : 1px;border-color:tile.selected ? Theme.accent : #a0a0a0;
    }
    touch := TouchArea {
     pointer-event(e) => {if e.kind==PointerEventKind.down {scope.focus();}Shell.row-pointer(tile.row,e);}
     double-clicked => {Shell.row-double-clicked(tile.row);}
     changed has-hover => {if self.has-hover {Shell.item-hovered(tile.row);}else {Shell.item-hovered(-1);Tip.pending=false;Tip.shown=false;}}
    }
   }
  }
  // This is the date scrubber, separate from the picture viewport.
  Rectangle {
   x:parent.width - 53px;y:0;width:42px;height:parent.height;
   for date in Shell.gallery-view ? Shell.gallery-dates : []: Text {
    x:2px;y:date.y;width:38px;height:19px;text:date.label;font-family:Theme.font-small;font-size:14px;color:Theme.text;vertical-alignment:center;
   }
   DateCaret{x:14px;y:67px;}
   DateCaret{x:14px;y:parent.height - 27px;down:true;}
   Rectangle {x:3px;y:Shell.gallery-indicator;width:30px;height:3px;border-radius:1.5px;background:Theme.accent;}
   date-touch := TouchArea {
    width:parent.width;height:parent.height;
    pointer-event(e) => {
     if e.kind==PointerEventKind.down && e.button==PointerEventButton.left {
      scope.focus();root.dragging-date=false;root.date-grab-offset=self.mouse-y - Shell.gallery-indicator;
      if self.mouse-y<75px {root.dragging-date=false;Shell.gallery-scroll(-48px);}else if self.mouse-y>parent.height - 31px {root.dragging-date=false;Shell.gallery-scroll(48px);}else if !root.dragging-date {Shell.gallery-scrub(self.mouse-y,true);}
     }
     if e.kind==PointerEventKind.up {root.dragging-date=false;}
    }
    moved => {if self.pressed && root.dragging-date && self.mouse-y>=75px && self.mouse-y<=parent.height - 31px {Shell.gallery-scrub(self.mouse-y - root.date-grab-offset,false);}}
   }
  }
  if date-touch.has-hover && date-touch.mouse-y>=75px && date-touch.mouse-y<=root.height - 31px: Rectangle {
   property <string> caption:Shell.gallery-date-at(date-touch.mouse-y);
   x:parent.width - self.width - 12px;y:date-touch.mouse-y - 35px;
   width:date-text.preferred-width+16px;height:33px;border-radius:4px;background:Theme.dark ? #2b2b2b : #ffffff;
   border-width:1px;border-color:Theme.dark ? #3c3c3c : #d6d6d6;
   drop-shadow-blur:8px;drop-shadow-offset-y:4px;drop-shadow-color:#00000055;
   date-text := Text{x:8px;width:parent.width - 16px;height:parent.height;text:parent.caption;font-family:Theme.font-small;font-size:14px;color:Theme.text;vertical-alignment:center;}
  }
 }
}
