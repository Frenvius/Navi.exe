import { Theme, Glyph, Glyphs } from "theme.slint";
import { TipArea } from "tooltip.slint";
import { KeyboardRing } from "focus.slint";
export struct CloudCommand { label:string, description:string, icon:image, state:int, slot:int, }
export struct CloudData { label:string, icon:image, account:string, quota:string, fraction:float, color:color, more:string, commands:[CloudCommand], }

export component CloudFlyout inherits Rectangle {
    in property <CloudData> data;
    callback command(int);
    in property <int> hot: -1;
    width:320px;
    height:202px + (root.data.more == "" ? 0px : 48px);
    border-radius:8px;
    background:Theme.dark ? #343434 : #fafafa;
    clip:true;
    for c in root.data.commands: Rectangle {
        visible:c.slot == 0 && c.state != 2;
        x:7px;y:6px;width:306px;height:37px;
        border-radius:4px;
        background:sync.has-hover || root.hot == c.slot ? Theme.subtle-hover : transparent;
        Image {x:6px;y:10px;width:16px;height:16px;source:c.icon;}
        Text {x:37px;y:7px;width:parent.width - 64px;height:20px;text:c.label;font-family:Theme.font-dui;font-size:14px;color:Theme.text;vertical-alignment:center;}
        if root.hot == c.slot: KeyboardRing {x:-3px;y:-3px;width:parent.width+6px;height:parent.height+6px;}
        Glyph {x:275px;y:6px;width:24px;height:24px;text:Glyphs.chevron-right-med;font-size:12px;}
        sync:=TipArea {tip:c.description;enabled:c.state==0;clicked=>{root.command(c.slot);}}
    }
    Rectangle {x:1px;y:49px;width:parent.width - 2px;height:1px;background:Theme.dark ? #2d2d2d : #e5e5e5;}
    Rectangle {x:1px;y:150px;width:parent.width - 2px;height:parent.height - 151px;background:Theme.dark ? #2c2c2c : #f3f3f3;}
    Text {x:15px;y:71px;width:290px;height:22px;text:root.data.account;font-family:Theme.font-dui;font-size:14px;font-weight:600;color:Theme.text;vertical-alignment:center;}
    Rectangle {x:15px;y:101px;width:290px;height:1px;background:Theme.dark ? #afafaf : #b3b3b3;
        Rectangle {x:0;y:0;width:parent.width*min(1,max(0,root.data.fraction));height:1px;border-radius:0.5px;background:root.data.color;}
    }
    Text {x:16px;y:107px;width:290px;height:20px;text:root.data.quota;font-family:Theme.font-dui;font-size:12px;color:Theme.text;vertical-alignment:center;}
    if root.data.more != "": Text {x:15px;y:148px;width:290px;height:44px;text:root.data.more;wrap:word-wrap;font-size:12px;color:Theme.text;}
    for c in root.data.commands: Rectangle {
        visible:c.slot > 0 && c.slot != 2 && c.state != 2;
        x:c.slot == 1 ? 9px : 217px + (c.slot - 3)*36px;
        y:160px + (root.data.more == "" ? 0px : 48px);
        width:c.slot == 1 ? 187px : 32px;height:32px;
        border-radius:4px;
        background:touch.has-hover || root.hot == c.slot ? Theme.subtle-hover : c.slot == 1 ? (Theme.dark ? #3b3b3b : #ffffff) : transparent;
        opacity:c.state == 1 ? 0.4 : 1;
        if c.slot == 1: Text {x:12px;y:-1px;width:parent.width - 24px;height:parent.height;text:c.label;font-family:Theme.font-text;font-size:14px;color:Theme.text;vertical-alignment:center;}
        if root.hot == c.slot: KeyboardRing {x:-3px;y:-3px;width:parent.width+6px;height:parent.height+6px;}
        if c.slot > 2: Image {x:8px;y:8px;width:16px;height:16px;source:c.icon;}
        touch:=TipArea {enabled:c.state==0;tip:c.description;clicked=>{root.command(c.slot);}}
    }
}
