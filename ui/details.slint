// Details view (DirectUI list in the Windows 11 dark theme), measured from explorer.exe.
import { Theme, Glyphs, Glyph } from "theme.slint";
import { Shell, Entry } from "shell.slint";
import { ScrollBar } from "scrollbar.slint";
import { ItemTip, Tip } from "tooltip.slint";
import { GroupHeader, EmptyLibraryHeader } from "group-header.slint";
import { CheckBox } from "check-box.slint";
import { SearchCell } from "search-cell.slint";


component HeaderCell inherits Rectangle {
    in property <string> label;
    in property <int> column;
    in property <bool> first;
    in property <bool> key-focused;
    in property <length> size;
    // Its sort arrow: 0 none, 1 up, 2 down.
    in property <int> sorted;
    callback resized(length);
    // A double click on its edge sizes it to fit.
    callback fit();
    // The left button pressed, moved or released over it, at this x in the window.
    callback pointer(int, length);
    // Where it's drawn; a dragged column follows the mouse, the others slide aside.
    in property <length> slot-x;
    property <bool> dragged: Shell.header-drag == root.column;
    property <bool> resizing;
    x: root.dragged ? Shell.header-drag-x : root.slot-x;
    z: root.dragged ? 1 : 0;
    animate x { duration: Shell.header-drag >= 0 && !root.dragged ? 333ms : 0ms; easing: ease-in-out; }
    width: root.size;
    height: 25px;
    // Explorer's header cells are buttons: hovered, pressed while the mouse is over them (or,
    // dragged, over the slot they'd drop into). The chevron part doesn't press the cell.
    property <bool> lit: root.dragged || (Shell.header-drag < 0 && (touch.has-hover || chevron.has-hover));
    // Its filter is open: framed (1px, the corners softened), the chevron shown.
    property <bool> open: (Shell.filter-framed && Shell.filter-column == root.column) || root.key-focused;
    background: root.open ? transparent
        : root.dragged ? (Shell.header-drag-over ? Theme.header-pressed : Theme.header-hover)
        : Shell.header-drag >= 0 ? transparent
        : touch.pressed && touch.has-hover ? Theme.header-pressed : root.lit ? Theme.header-hover : transparent;

    touch := TouchArea {
        width: root.width - 16px;
        clicked => { Shell.sort-clicked(root.column); }
        pointer-event(e) => {
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
                Shell.header-context(root.column, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
            if e.button == PointerEventButton.left {
                if e.kind == PointerEventKind.down { root.pointer(0, self.absolute-position.x + self.mouse-x); }
                if e.kind == PointerEventKind.up { root.pointer(2, self.absolute-position.x + self.mouse-x); }
            }
        }
        moved => {
            if self.pressed { root.pointer(1, self.absolute-position.x + self.mouse-x); }
        }
    }
    // The filter chevron's part: it opens the filter (or closes it), and neither sorts nor drags.
    chevron := TouchArea {
        x: root.width - 16px;
        width: 16px;
        clicked => {
            if root.open {
                Shell.filter-dismissed();
            } else {
                Shell.header-filter(root.column, self.absolute-position.x, root.absolute-position.y + root.height);
            }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
                Shell.header-context(root.column, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    // The frame's corner pixels are at half, and the pixels inside them at 43%.
    if root.open: Rectangle {
        Rectangle { x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px; background: Theme.header-open; }
        Rectangle { x: 1px; y: 0; width: parent.width - 2px; height: 1px; background: Theme.header-open-border; }
        Rectangle { x: 1px; y: parent.height - 1px; width: parent.width - 2px; height: 1px; background: Theme.header-open-border; }
        Rectangle { x: 0; y: 1px; width: 1px; height: parent.height - 2px; background: Theme.header-open-border; }
        Rectangle { x: parent.width - 1px; y: 1px; width: 1px; height: parent.height - 2px; background: Theme.header-open-border; }
        for c in [{ x: 0, y: 0 }, { x: 1, y: 0 }, { x: 0, y: 1 }, { x: 1, y: 1 }]: Rectangle {
            x: c.x == 0 ? 0px : parent.width - 1px;
            y: c.y == 0 ? 0px : parent.height - 1px;
            width: 1px;
            height: 1px;
            background: Theme.header-open-border;
            opacity: 0.5;
        }
        for c in [{ x: 0, y: 0 }, { x: 1, y: 0 }, { x: 0, y: 1 }, { x: 1, y: 1 }]: Rectangle {
            x: c.x == 0 ? 1px : parent.width - 2px;
            y: c.y == 0 ? 1px : parent.height - 2px;
            width: 1px;
            height: 1px;
            background: Theme.header-open-border;
            opacity: 0.43;
        }
    }
    if root.lit || root.open: Rectangle {
        x: root.width - 16px;
        y: root.open ? 1px : 0px;
        width: 1px;
        height: root.open ? parent.height - 2px : parent.height;
        background: root.open ? Theme.header-open-divider : Theme.header-chevron-divider;
    }
    // Its chevron, 7 by 4 at width-12 and 10 down, as the real inks it: the left arm a crisp
    // diagonal, the right one a little steeper, spread over two pixels (coverage measured).
    if root.lit || root.open: Rectangle {
        x: root.width - 12px;
        y: 10px;
        width: 7px;
        height: 4px;
        property <color> ink: root.open ? Theme.header-open-chevron : chevron.pressed ? Theme.header-chevron-pressed : Theme.header-chevron;
        for p in [
            { x: 0, y: 0, a: 1.0 }, { x: 1, y: 0, a: 0.22 }, { x: 5, y: 0, a: 0.43 }, { x: 6, y: 0, a: 0.57 },
            { x: 0, y: 1, a: 0.22 }, { x: 1, y: 1, a: 1.0 }, { x: 2, y: 1, a: 0.22 }, { x: 4, y: 1, a: 0.43 }, { x: 5, y: 1, a: 0.71 },
            { x: 1, y: 2, a: 0.22 }, { x: 2, y: 2, a: 1.0 }, { x: 3, y: 2, a: 0.57 }, { x: 4, y: 2, a: 0.71 },
            { x: 2, y: 3, a: 0.22 }, { x: 3, y: 3, a: 0.64 },
        ]: Rectangle {
            x: p.x * 1px;
            y: p.y * 1px;
            width: 1px;
            height: 1px;
            background: parent.ink;
            opacity: p.a;
        }
    }

    // The sort arrow at the top, centred on the cell (the first one's past the room its wider
    // indent takes, 11px), as the real inks it (coverage measured): down 7 by 4, 1px down;
    // up 9 by 5, a pixel further left, at the top.
    property <length> arrow-from: root.first ? 11px : 0px;
    property <length> arrow-x: root.arrow-from + floor((root.width - root.arrow-from - 7px) / 2 / 1px) * 1px;
    if root.sorted == 2: Rectangle {
        x: root.arrow-x;
        y: 1px;
        width: 7px;
        height: 4px;
        for p in [
            { x: 0, y: 0, a: 0.9 }, { x: 1, y: 0, a: 0.34 }, { x: 5, y: 0, a: 0.34 }, { x: 6, y: 0, a: 0.9 },
            { x: 1, y: 1, a: 1.0 }, { x: 2, y: 1, a: 0.34 }, { x: 4, y: 1, a: 0.34 }, { x: 5, y: 1, a: 1.0 },
            { x: 2, y: 2, a: 1.0 }, { x: 3, y: 2, a: 0.56 }, { x: 4, y: 2, a: 1.0 },
            { x: 3, y: 3, a: 0.67 },
        ]: Rectangle {
            x: p.x * 1px;
            y: p.y * 1px;
            width: 1px;
            height: 1px;
            background: Theme.sort-down;
            opacity: p.a;
        }
    }
    if root.sorted == 1: Rectangle {
        x: root.arrow-x - 1px;
        y: 0;
        width: 9px;
        height: 5px;
        for p in [
            { x: 3, y: 0, a: 0.08 }, { x: 4, y: 0, a: 0.77 }, { x: 5, y: 0, a: 0.08 },
            { x: 2, y: 1, a: 0.08 }, { x: 3, y: 1, a: 1.0 }, { x: 4, y: 1, a: 0.61 }, { x: 5, y: 1, a: 0.93 }, { x: 6, y: 1, a: 0.08 },
            { x: 1, y: 2, a: 0.08 }, { x: 2, y: 2, a: 1.0 }, { x: 3, y: 2, a: 0.47 }, { x: 5, y: 2, a: 0.23 }, { x: 6, y: 2, a: 0.93 }, { x: 7, y: 2, a: 0.08 },
            { x: 0, y: 3, a: 0.08 }, { x: 1, y: 3, a: 1.0 }, { x: 2, y: 3, a: 0.47 }, { x: 6, y: 3, a: 0.23 }, { x: 7, y: 3, a: 0.93 }, { x: 8, y: 3, a: 0.08 },
            { x: 0, y: 4, a: 0.08 }, { x: 1, y: 4, a: 0.38 }, { x: 7, y: 4, a: 0.23 }, { x: 8, y: 4, a: 0.23 },
        ]: Rectangle {
            x: p.x * 1px;
            y: p.y * 1px;
            width: 1px;
            height: 1px;
            background: Theme.sort-up;
            opacity: p.a;
        }
    }

    if root.first && Shell.check-boxes: CheckBox {
        x: 11px;
        y: 6px;
        checked: Shell.all-selected;
        toggled => { Shell.check-all(!self.checked); }
    }

    Text {
        x: root.first ? (Shell.check-boxes ? 34px : 17px) + (Shell.compact ? 0px : 13px) : 6px;
        // Elided 6px before the edge: "Artistas participantes" (110px) doesn't fit in 120.
        width: parent.width - self.x - 6px;
        height: parent.height - 2px;
        text: root.label;
        font-family: Theme.font-dui;
        font-size: 12px;
        color: Theme.header-text;
        vertical-alignment: center;
        overflow: elide;
    }

    // Column divider, under the fill of a lit cell.
    if root.background == transparent && !root.open: Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.header-divider;
    }

    resizer := TouchArea {
        x: parent.width - 4px;
        width: 8px;
        mouse-cursor: col-resize;
        // The width and the pointer's x in the window at the press: the edge moves with the
        // width, so its own coordinates would lag behind the pointer.
        property <length> start;
        property <length> start-x;
        double-clicked => { root.fit(); }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                self.start = root.size;
                self.start-x = self.absolute-position.x + self.mouse-x;
            }
        }
        moved => {
            if self.pressed {
                root.resized(max(30px, self.start + self.absolute-position.x + self.mouse-x - self.start-x));
            }
        }
    }
}

component DetailRow inherits Rectangle {
    in property <Entry> entry;
    in property <int> index;
    in property <bool> list-focus;
    in property <length> row-width;
    in property <length> viewport-width;
    callback focus-list();
    property <bool> focused: Shell.focused-row == root.index;
    property <bool> renaming: Shell.renaming-row == root.index && !Shell.icons-view && !Shell.drives-view;
    property <bool> dragging;
    // The roomy (non-compact) row: a 24px highlight, its contents 2px lower.
    property <length> lower: Shell.compact ? 0px : 2px;
    height: Shell.compact ? 21px : 28px;

    highlight := Rectangle {
        x: 14px;
        y: 0;
        width: root.row-width;
        height: Shell.compact ? 22px : 24px;
        // The focused row of a multiple selection looks singly selected; the row being renamed
        // looks like part of a multiple selection.
        property <bool> active: root.list-focus || Shell.renaming-row >= 0;
        property <bool> multi: self.active && root.entry.selected && Shell.multi-selected && (!root.focused || root.renaming);
        property <bool> search-caret: Shell.search-view && root.list-focus && !root.entry.selected
            && (root.focused || (root.index == 0 && Shell.focused-row < 0));
        background: root.entry.selected
            ? (self.multi ? Theme.row-multi : !self.active ? Theme.nav-selected : root.renaming ? Theme.row-selected : touch.has-hover && !Shell.file-drag && !Shell.single-click ? Theme.row-selected-hover : Theme.row-selected)
            : ((touch.has-hover && !Shell.file-drag) || Shell.drop-row == root.index) ? Theme.row-hover : transparent;
        // The light theme also edges a selection without the focus.
        border-width: self.search-caret || self.multi || (self.active && root.focused && root.entry.selected) || (!self.active && root.entry.selected) ? 1px : 0px;
        border-color: self.search-caret ? Theme.dui-text : self.multi ? Theme.row-multi-border : !self.active ? Theme.nav-selected-border : Theme.focus-rect;

        touch := TouchArea {
            mouse-cursor: Shell.single-click ? pointer : default;
            changed has-hover => { Shell.row-hover(root.index,self.has-hover,self.absolute-position.x+self.mouse-x,self.absolute-position.y+self.mouse-y); }
            changed mouse-x => { if self.has-hover && !self.pressed { Shell.row-hover(root.index,true,self.absolute-position.x+self.mouse-x,self.absolute-position.y+self.mouse-y); } }
            changed mouse-y => { if self.has-hover && !self.pressed { Shell.row-hover(root.index,true,self.absolute-position.x+self.mouse-x,self.absolute-position.y+self.mouse-y); } }
            moved => {
                if self.pressed && !root.dragging && root.entry.selected
                    && (abs(self.mouse-x - self.pressed-x) > 4px || abs(self.mouse-y - self.pressed-y) > 4px) {
                    root.dragging = true;
                    Shell.drag-start();
                }
            }
            pointer-event(e) => {
                if e.kind == PointerEventKind.down { root.focus-list(); root.dragging = false; }
                if e.kind == PointerEventKind.up && root.dragging { root.dragging = false; return; }
                Shell.row-pointer(root.index, e);
                if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
                    Shell.list-context(root.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, e.modifiers.shift);
                }
            }
            double-clicked => { Shell.row-double-clicked(root.index); }
        }
    }

    // The keyboard's tip: under the highlight, 4px in.
    property <bool> key-tip: Shell.key-tip-row == root.index;
    changed key-tip => {
        if self.key-tip && root.entry.tip != "" {
            Tip.text = root.entry.tip;
            Tip.x = highlight.absolute-position.x + 4px;
            Tip.y = highlight.absolute-position.y + highlight.height;
            Tip.classic = true;
            Tip.pending = false;
            Tip.shown = true;
        }
    }

    // The keyboard's menu opens at the icon's middle, a pixel right.
    property <bool> key-menu: Shell.key-menu-row == root.index && !Shell.icons-view && !Shell.drives-view;
    changed key-menu => {
        if self.key-menu {
            Shell.key-menu-row = -1;
            Shell.key-menu(root.index, icon.absolute-position.x + 9px, icon.absolute-position.y + 8px);
        }
    }

    ItemTip {
        hover: touch.has-hover;
        pressed: touch.pressed;
        tip: root.entry.tip;
        pointer-x: touch.absolute-position.x + touch.mouse-x;
        pointer-y: touch.absolute-position.y + touch.mouse-y;
        request => { Shell.item-hovered(root.index); }
    }

    if Shell.check-boxes && (touch.has-hover || root.entry.selected): CheckBox {
        x: 18px;
        y: 4px + root.lower;
        checked: root.entry.selected;
        toggled => {
            root.focus-list();
            Shell.row-check(root.index);
        }
    }

    property <length> shift: Shell.check-boxes ? 15px : 0px;
    icon := Image {
        x: 14px + 4px + root.shift;
        y: 2px + root.lower;
        width: 16px;
        height: 16px;
        source: root.entry.icon;
        opacity: root.entry.ghost ? 0.5 : 1;
    }

    // A 20px line in the 21px row: centering it would round half a pixel down.
    if !root.renaming || Shell.name-column != 0: SearchCell {
        x: 14px + 24px + root.shift + (Shell.compact ? 0px : 1px);
        y: root.lower;
        width: Shell.col-name - self.x - (Shell.lead-right ? 8px : 6px);
        height: 20px;
        text: Shell.lead-label == "" ? root.entry.name : root.entry.lead;
        // The name's colour goes with Name, wherever it is.
        ink: Shell.lead-label == "" ? (root.entry.name-style == 1 ? Theme.compressed-text : root.entry.name-style == 2 ? Theme.encrypted-text : Theme.dui-text) : Theme.cell-text;
        align-right: Shell.lead-right;
        underline: Shell.single-click && (!Shell.underline-hover-only || touch.has-hover);
        mark: !root.renaming && (Shell.name-column == 0 || Shell.lead-folder);
    }

    if root.renaming: Rectangle {
        z: 1;
        x: Shell.name-column-x + (Shell.name-column == 0 ? 14px + 20px + root.shift : 2px);
        y: root.lower + 1px;
        // The edit is 37px wider than the name (GDI width; ours measures a pixel wider).
        width: min(max(20px,root.viewport-width - self.x - Shell.list-scroll-x - 3px), input.preferred-width + 36px);
        height: 19px;
        background: Theme.details-edit-box;
        border-width: 1px;
        border-color: Theme.edit-border;
        clip: true;
        field := Rectangle {
            x: 4px;
            width: parent.width - 7px;
            clip: true;
            property <length> text-scroll: min(0px,self.width - input.preferred-width);
        input := TextInput {
            x: parent.text-scroll;
            width: max(parent.width,self.preferred-width + 2px);
            text: Shell.rename-seed;
            font-family: Theme.font-dui;
            font-size: 12px;
            color: Theme.dui-text;
            vertical-alignment: center;
            single-line: true;
            selection-background-color: Theme.edit-selection;
            selection-foreground-color: Theme.edit-selection-text;
            property <bool> done;
            cursor-position-changed(pos) => {
                if pos.x + parent.text-scroll < 0px { parent.text-scroll = -pos.x; }
                else if pos.x + parent.text-scroll > parent.width - 2px { parent.text-scroll = parent.width - 2px - pos.x; }
            }
            init => {
                self.focus();
                self.set-selection-offsets(0, Shell.rename-select-end);
            }
            accepted => {
                if !self.done {
                    self.done = true;
                    Shell.rename-finished(true, self.text);
                }
            }
            key-pressed(e) => {
                if e.text == Key.Escape {
                    self.done = true;
                    Shell.rename-finished(false, self.text);
                    return accept;
                }
                reject
            }
            changed has-focus => {
                if !self.has-focus && !self.done {
                    self.done = true;
                    Shell.rename-finished(true, self.text);
                }
            }
        }
        }
    }

    // The other columns: 6px in, the right-aligned ones ending 8px before the next.
    for column[i] in Shell.columns: SearchCell {
        visible: !root.renaming || !column.name;
        x: Shell.col-name + column.x + 6px;
        y: root.lower;
        width: column.width - (column.right ? 14px : 12px);
        height: 20px;
        text: i < root.entry.cells.length ? root.entry.cells[i] : "";
        ink: column.name ? (root.entry.name-style == 1 ? Theme.compressed-text : root.entry.name-style == 2 ? Theme.encrypted-text : Theme.dui-text) : Theme.cell-text;
        align-right: column.right;
        underline: Shell.single-click && (!Shell.underline-hover-only || touch.has-hover);
        mark: column.name || column.folder;
    }
}

export component DetailsView inherits Rectangle {
    background: Theme.content;
    forward-focus: scope;

    property <length> total: Shell.col-name + Shell.columns-width;
    property <length> band-x0;
    property <length> band-y0;
    property <length> band-x1;
    property <length> band-y1;
    property <bool> banding;
    property <bool> band-moved;
    property <length> band-mouse-y;
    // Each bar takes 17px from the rows, and either may need the room the other takes.
    property <length> rows-height: root.height - 25px;
    property <bool> tall: Shell.list-extent > root.rows-height;
    // The columns scroll sideways 9px past their end.
    property <length> extent-x: root.total + (Shell.search-view ? 10px : 9px);
    property <bool> wide: root.extent-x > root.width;
    property <bool> vbar-shown: Shell.entries.length > 0 && (root.tall || (root.wide && Shell.list-extent > root.rows-height - 17px));
    property <bool> hbar-shown: Shell.entries.length > 0 && (root.wide || (root.tall && root.extent-x > root.width - 17px));

    public function focus-list() { scope.focus(); }
    property <int> header-at;
    public function focus-header() { root.header-at = 0; Shell.list-scroll-x = 0px; header-scope.focus(); }
    header-scope := FocusScope {
        changed has-focus => { if self.has-focus { Shell.focus-noted("header"); } }
        key-pressed(e) => {
            if e.text == Key.RightArrow || e.text == Key.LeftArrow {
                root.header-at = mod(root.header-at + (e.text == Key.RightArrow ? 1 : Shell.columns.length),Shell.columns.length + 1);
                let left = root.header-at == 0 ? 0px : Shell.col-name + Shell.columns[root.header-at - 1].x;
                let width = root.header-at == 0 ? Shell.col-name : Shell.columns[root.header-at - 1].width;
                if left < -Shell.list-scroll-x { Shell.list-scroll-x = -left; }
                else if left + width > -Shell.list-scroll-x + list.width {
                    Shell.list-scroll-x = -(left + width - list.width);
                }
                return accept;
            }
            if e.text == Key.Return || e.text == " " { Shell.sort-clicked(root.header-at); return accept; }
            if e.text == Key.DownArrow {
                Shell.header-filter(root.header-at,root.absolute-position.x + (root.header-at == 0 ? 0px : Shell.col-name + Shell.columns[root.header-at - 1].x),root.absolute-position.y + 25px);
                return accept;
            }
            if e.text == Key.Escape { scope.focus(); return accept; }
            reject
        }
    }

    // The keyboard's menu for the folder opens at the view's corner.
    property <bool> key-menu: Shell.key-menu-row == -2 && !Shell.icons-view && !Shell.drives-view;
    changed key-menu => {
        if self.key-menu {
            Shell.key-menu-row = -1;
            Shell.key-menu(-1, root.absolute-position.x, root.absolute-position.y);
        }
    }

    scope := FocusScope {
        changed has-focus => { Shell.list-focused = self.has-focus; if self.has-focus { Shell.focus-noted("list"); } }
        key-pressed(e) => {
            // A key puts an item's tip away.
            Tip.pending = false;
            Tip.shown = false;
            if Shell.list-key(e) { return accept; }
            reject
        }

        // Empty space: clears the selection and starts a rubber band.
        background := TouchArea {
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    scope.focus();
                    Shell.background-pointer(e);
                    if e.button == PointerEventButton.left {
                        root.banding = true;
                        root.band-moved = false;
                        root.band-x0 = self.mouse-x - list.content-x;
                        root.band-y0 = self.mouse-y - 25px - list.content-y;
                        root.band-x1 = root.band-x0;
                        root.band-y1 = root.band-y0;
                    }
                }
                if e.kind == PointerEventKind.up {
                    if e.button == PointerEventButton.left { root.banding = false; }
                    if e.button == PointerEventButton.right {
                        Shell.list-context(-1, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, e.modifiers.shift);
                    }
                }
            }
            moved => {
                if root.banding {
                    root.band-mouse-y = self.mouse-y;
                    root.band-x1 = self.mouse-x - list.content-x;
                    root.band-y1 = self.mouse-y - 25px - list.content-y;
                    if abs(root.band-x1 - root.band-x0) >= 4px || abs(root.band-y1 - root.band-y0) >= 4px {
                        root.band-moved = true;
                    }
                    if root.band-moved {
                        Shell.band-changed(min(root.band-x0, root.band-x1), min(root.band-y0, root.band-y1),
                            abs(root.band-x1 - root.band-x0), abs(root.band-y1 - root.band-y0),
                            self.pressed, false);
                    }
                }
            }
        }

        // A band held at (or past) the rows' top or bottom edge scrolls the list, faster the
        // farther out: every 47ms by the distance past the edge and 3px, 4px at least (as
        // Explorer's), its end following the content.
        property <bool> band-down: root.band-mouse-y >= list.y + list.height - 1px;
        property <bool> band-up: root.band-mouse-y <= list.y;
        Timer {
            interval: 47ms;
            running: root.banding && root.band-moved && (band-down || band-up);
            triggered => {
                if band-down {
                    Shell.list-nudge(max(4px, root.band-mouse-y - list.y - list.height + 3px));
                } else {
                    Shell.list-nudge(-max(4px, list.y - root.band-mouse-y + 3px));
                }
                root.band-y1 = root.band-mouse-y - 25px - list.content-y;
                Shell.band-changed(min(root.band-x0, root.band-x1), min(root.band-y0, root.band-y1),
                    abs(root.band-x1 - root.band-x0), abs(root.band-y1 - root.band-y0), background.pressed, false);
            }
        }

        // Only the rows near the shown part exist (Rust picks them as the list scrolls), at
        // their tops in the content; the wheel and the keys scroll it from Rust too.
        list := Flickable {
            x: 0;
            y: 25px;
            width: parent.width - (root.vbar-shown ? 17px : 0px);
            height: parent.height - 25px - (root.hbar-shown ? 17px : 0px);
            interactive: false;
            content-height: max(self.height, Shell.list-extent);
            content-width: max(self.width, root.extent-x);
            content-y <=> Shell.list-scroll-y;
            // Scrolling puts an item's tip away.
            changed content-y => { Tip.pending = false; Tip.shown = false; }
            content-x <=> Shell.list-scroll-x;
            changed height => { Shell.list-viewport(self.height); }
            init => { Shell.list-viewport(self.height); }

            for slot in Shell.list-rows: Rectangle {
                property <Entry> entry: Shell.entries[slot.index];
                x: 0;
                y: slot.y;
                width: parent.width;
                height: Shell.compact ? 21px : 28px;
                // A group's header sits above its first row: 32px, 30px once collapsed.
                if entry.header != "": GroupHeader {
                    x: 0;
                    y: (entry.folded ? -30px : -32px) - (Shell.group-subtitle(entry.header) == "" ? 0px : 18px);
                    label: entry.header;
                    collapsed: entry.collapsed;
                    index: slot.index;
                    list-focus: scope.has-focus;
                    plate-width: list.width - 18px;
                    focus-list => { scope.focus(); }
                }
                if !entry.folded: DetailRow {
                    viewport-width: list.width;
                    x: 0;
                    y: 0;
                    width: parent.width;
                    entry: entry;
                    index: slot.index;
                    list-focus: scope.has-focus;
                    row-width: root.total - 18px;
                    focus-list => { scope.focus(); }
                }
            }
            for group in Shell.empty-library-groups: EmptyLibraryHeader {
                x: group.x;
                y: group.y;
                width: list.width;
                label: group.label;
                folded: group.folded;
            }
        }

        // Sticky header, scrolled horizontally with the rows.
        Rectangle {
            visible: !Shell.home-view;
            x: 0;
            y: 0;
            width: list.width;
            height: 25px;
            background: Theme.content;
            clip: true;
            // Past the last column the header still gives its menu.
            TouchArea {
                pointer-event(e) => {
                    if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
                        Shell.header-context(-1, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
            }
            cells := Rectangle {
                x: list.content-x;
                width: root.total;
                HeaderCell {
                    key-focused: header-scope.has-focus && root.header-at == 0;
                    label: Shell.lead-label == "" ? @tr("column.name") : Shell.lead-label;
                    column: 0;
                    first: true;
                    slot-x: Shell.lead-x;
                    size: Shell.col-name;
                    sorted: Shell.lead-sorted;
                    resized(w) => { Shell.col-name = w; Shell.column-resized(-1, w); }
                    fit => { Shell.column-fit(0); }
                    pointer(phase, x) => { Shell.header-pointer(0, phase, x - cells.absolute-position.x); }
                }
                for column[i] in Shell.columns: HeaderCell {
                    key-focused: header-scope.has-focus && root.header-at == i + 1;
                    label: column.label;
                    column: i + 1;
                    slot-x: Shell.col-name + column.x;
                    size: column.width;
                    sorted: column.sorted;
                    resized(w) => { Shell.column-resized(i, w); }
                    fit => { Shell.column-fit(i + 1); }
                    pointer(phase, x) => { Shell.header-pointer(i + 1, phase, x - cells.absolute-position.x); }
                }
            }
        }

        // The band, cut to the rows' area.
        if root.banding && root.band-moved: Rectangle {
            x: list.x;
            y: list.y;
            width: list.width;
            height: list.height;
            clip: true;
            Rectangle {
                x: min(root.band-x0, root.band-x1) + list.content-x;
                y: min(root.band-y0, root.band-y1) + list.content-y;
                width: abs(root.band-x1 - root.band-x0);
                height: abs(root.band-y1 - root.band-y0);
                border-width: 1px;
                border-color: Theme.band-border;
                background: Theme.band;
            }
        }

        // "Esta pasta está vazia.": in the items' colour, 14px below the header. Home's is
        // its XAML page's (Segoe UI Variable Small, semilight, the tertiary text colour).
        if Shell.entries.length == 0 && Shell.empty-library-groups.length == 0: Text {
            y: Shell.home-view ? 36px : 39px;
            width: parent.width;
            text: Shell.error-text != "" ? Shell.error-text : Shell.empty-text;
            font-family: Shell.home-view ? "Segoe UI Variable Small" : Theme.font-dui;
            font-weight: Shell.home-view ? 350 : 400;
            font-size: 12px;
            color: Shell.home-view ? Theme.text-tertiary : Theme.dui-text;
            horizontal-alignment: center;
        }

        // Explorer's bars are 17px; the vertical one runs alongside the column headers too.
        vbar := ScrollBar {
            dui: true;
            stepped: true;
            visible: root.vbar-shown;
            x: parent.width - 17px;
            y: 0;
            width: 17px;
            height: parent.height - (root.hbar-shown ? 17px : 0px);
            value <=> list.content-y;
            content: list.content-height;
            page: list.height;
            scrolled => { Shell.list-scrolled(); }
            lines(n) => { Shell.list-lines(n); }
            pages(n) => { Shell.list-pages(n); }
        }
        hbar := ScrollBar {
            dui: true;
            horizontal: true;
            visible: root.hbar-shown;
            x: 0;
            y: parent.height - 17px;
            height: 17px;
            width: parent.width - (root.vbar-shown ? 17px : 0px);
            value <=> list.content-x;
            content: list.content-width;
            page: list.width;
        }
        // The square between the bars takes clicks and does nothing with them.
        if root.vbar-shown && root.hbar-shown: TouchArea {
            x: parent.width - 17px;
            y: parent.height - 17px;
            width: 17px;
            height: 17px;
        }
    }
}
