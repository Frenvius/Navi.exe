// "Este Computador": drives as 250x52 tiles with a usage bar, grouped like Explorer.
import { Theme } from "theme.slint";
import { Shell, Entry, Icons } from "shell.slint";
import { ScrollBar } from "scrollbar.slint";
import { GroupHeader } from "group-header.slint";
import { Underlines } from "underline.slint";

component Tile inherits Rectangle {
    in property <Entry> entry;
    in property <int> index;
    in property <bool> list-focus;
    callback focus-list();
    property <bool> focused: Shell.focused-row == root.index;
    property <bool> multi: root.list-focus && root.entry.selected && (Shell.focused-group >= 0 || (Shell.multi-selected && !root.focused));
    width: 250px;
    height: 52px;
    border-radius: 2px;
    background: !root.entry.selected && (touch.has-hover || Shell.drop-row == root.index) ? Theme.row-hover : transparent;
    border-width: !root.entry.selected && (touch.has-hover || (root.list-focus && root.focused)) ? 1px : 0px;
    border-color: root.list-focus && root.focused ? Theme.focus-rect : Theme.tile-border;
    if root.entry.selected: Image {
        width: parent.width;
        height: parent.height;
        source: !root.list-focus && !touch.has-hover ? Icons.tile-unfocused
            : root.multi && !touch.has-hover ? Icons.tile-multi : Icons.tile-focused;
        image-fit: fill;
    }

    touch := TouchArea {
        mouse-cursor: Shell.single-click ? pointer : default;
        changed has-hover => { Shell.row-hover(root.index,self.has-hover,self.absolute-position.x+self.mouse-x,self.absolute-position.y+self.mouse-y); }
        changed mouse-x => { if self.has-hover && !self.pressed { Shell.row-hover(root.index,true,self.absolute-position.x+self.mouse-x,self.absolute-position.y+self.mouse-y); } }
        changed mouse-y => { if self.has-hover && !self.pressed { Shell.row-hover(root.index,true,self.absolute-position.x+self.mouse-x,self.absolute-position.y+self.mouse-y); } }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down { root.focus-list(); }
            Shell.row-pointer(root.index, e);
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
                Shell.list-context(root.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, e.modifiers.shift);
            }
        }
        double-clicked => { Shell.row-double-clicked(root.index); }
    }

    // The keyboard's menu opens at the icon's middle, a pixel right.
    property <bool> key-menu: Shell.key-menu-row == root.index && Shell.drives-view;
    changed key-menu => {
        if self.key-menu {
            Shell.key-menu-row = -1;
            Shell.key-menu(root.index, root.absolute-position.x + 1px + 25px, root.absolute-position.y + 2px + 24px);
        }
    }

    // The drive's 48px icon, 4px in (measured: its ink 223-265 for a tile at 219).
    Image {
        x: 4px;
        y: 2px;
        width: 48px;
        height: 48px;
        source: root.entry.big-icon;
    }

    Text {
        x: 57px;
        y: root.entry.group == 1 && root.entry.meta == "" ? 8px : 1px;
        width: parent.width - 57px - 4px;
        height: 16px;
        text: root.entry.name;
        font-family: Theme.font-dui;
        font-size: 12px;
        color: root.entry.name-style == 1 ? Theme.compressed-text : root.entry.name-style == 2 ? Theme.encrypted-text : Theme.dui-text;
        vertical-alignment: center;
        overflow: elide;
        if Shell.single-click && (!Shell.underline-hover-only || touch.has-hover): Underlines { width: parent.width; text: parent.text; ink: parent.color; }
    }

    if root.entry.meta != "": Rectangle {
        x: 56px;
        y: 19px;
        width: 189px;
        height: 13px;
        background: Theme.drive-bar;
        border-width: 1px;
        border-color: Theme.drive-bar-border;
        Rectangle {
            x: 1px;
            y: 1px;
            width: (parent.width - 2px) * root.entry.usage;
            height: parent.height - 2px;
            background: root.entry.low ? Theme.drive-full : Theme.drive-fill;
        }
    }

    if root.entry.meta != "": Text {
        x: 56px;
        y: 32px;
        width: parent.width - 57px - 4px;
        height: 16px;
        text: root.entry.meta;
        font-family: Theme.font-dui;
        font-size: 12px;
        color: Theme.muted;
        vertical-alignment: center;
        overflow: elide;
        if Shell.single-click && (!Shell.underline-hover-only || touch.has-hover): Underlines { width: parent.width; text: parent.text; ink: parent.color; }
    }
}

export component TilesView inherits Rectangle {
    background: Theme.content;
    forward-focus: scope;

    property <int> devices: Shell.group-counts.length > 0 ? Shell.group-counts[0] : 0;
    property <int> network: Shell.group-counts.length > 1 ? Shell.group-counts[1] : 0;
    property <bool> active: Shell.drives-view;
    changed width => { if root.active { Shell.drives-viewport(root.width, root.height); } }
    changed height => { if root.active { Shell.drives-viewport(root.width, root.height); } }
    changed active => { if root.active { Shell.drives-viewport(root.width, root.height); } }

    public function focus-list() { scope.focus(); }

    // The keyboard's menu for the folder opens at the view's corner.
    property <bool> key-menu: Shell.key-menu-row == -2 && Shell.drives-view;
    changed key-menu => {
        if self.key-menu {
            Shell.key-menu-row = -1;
            Shell.key-menu(-1, root.absolute-position.x, root.absolute-position.y);
        }
    }

    scope := FocusScope {
        changed has-focus => { Shell.list-focused = self.has-focus; if self.has-focus { Shell.focus-noted("list"); } }
        key-pressed(e) => {
            if Shell.list-key(e) { return accept; }
            reject
        }

        TouchArea {
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    scope.focus();
                    Shell.background-pointer(e);
                }
                if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
                    Shell.list-context(-1, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, e.modifiers.shift);
                }
            }
        }

        flick := Flickable {
            interactive: false;
            content-height: max(self.height, Shell.grid-height);
            content-y: Shell.list-scroll-y;

            if root.devices > 0: GroupHeader {
                x: 0px;
                y: 2px;
                width: parent.width;
                plate-width: parent.width - (Shell.grid-height > flick.height ? 17px : 0px);
                label: @tr("tiles.drives");
                index: 0;
                collapsed: Shell.drives-devices-collapsed;
                highlight-collapsed-focus: true;
                list-focus: scope.has-focus;
                focus-list => { scope.focus(); }
            }
            if root.network > 0: GroupHeader {
                x: 0px;
                y: 2px + Shell.drives-device-height;
                width: parent.width;
                plate-width: parent.width - (Shell.grid-height > flick.height ? 17px : 0px);
                label: @tr("tiles.network");
                index: root.devices;
                collapsed: Shell.drives-network-collapsed;
                highlight-collapsed-focus: true;
                list-focus: scope.has-focus;
                focus-list => { scope.focus(); }
            }

            // Only while shown (This PC), like the icon views' cells.
            for i in Shell.drives-view ? Shell.grid-slots : []: Tile {
                entry: Shell.entries[i];
                x: self.entry.cell-x;
                y: self.entry.cell-y;
                index: i;
                list-focus: scope.has-focus;
                focus-list => { scope.focus(); }
            }
        }

        ScrollBar {
            dui: true;
            stepped: true;
            x: parent.width - self.width;
            y: 0;
            width: 17px;
            value <=> Shell.drives-scroll-units;
            content: Shell.drives-scroll-extent;
            page: Shell.drives-scroll-page;
            lines(n) => { Shell.list-lines(n); }
            pages(n) => { Shell.list-pages(n); }
            scrolled => { Shell.drives-thumb(-self.value); }
        }
    }
}
